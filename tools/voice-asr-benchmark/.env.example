# Copy to .env locally; never put credentials in Git, browser code or chat.
OPENAI_API_KEY=
OPENAI_ASR_MODEL=gpt-transcribe
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SESSION_TOKEN=
TENCENT_REGION=ap-guangzhou
TENCENT_ASR_ENGINE=16k_zh
ASR_TIMEOUT_MS=60000
BENCHMARK_PORT=8787
# Optional existing read-only Firebase ID token / Google OAuth access token.
# With no token, the server reads data/master-data.json (a genuine ERP export).
ERP_FIRESTORE_TOKEN=
