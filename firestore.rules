rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function validWorker(data) {
      return data.keys().hasOnly(['name', 'active', 'order'])
        && data.keys().hasAll(['name', 'active', 'order'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.active is bool
        && data.order is int && data.order >= 0;
    }

    function validWageEntry(data) {
      return data.keys().hasOnly([
          'dateKey', 'workerId', 'workerName', 'weightKg', 'rateRm',
          'wageRm', 'createdBy', 'createdAt', 'updatedAt', 'deleted'
        ])
        && data.keys().hasAll([
          'dateKey', 'workerId', 'workerName', 'weightKg', 'rateRm',
          'wageRm', 'createdBy', 'createdAt', 'updatedAt', 'deleted'
        ])
        && data.dateKey is string && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.workerId is string && data.workerId.size() > 0
        && data.workerName is string && data.workerName.size() > 0
        && data.weightKg is int && data.weightKg >= 1 && data.weightKg <= 300
        && data.rateRm is string && data.rateRm.matches('^[0-9][.][0-9]{2}$') && data.rateRm != '0.00'
        && data.wageRm is string && data.wageRm.matches('^[0-9]+[.][0-9]{2}$')
        && data.createdBy is string && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.deleted is bool;
    }

    match /workers/{workerId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validWorker(request.resource.data);
      allow delete: if false;
    }

    match /fishHeadWageEntries/{entryId} {
      allow read: if signedIn();
      allow create: if signedIn() && validWageEntry(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.deleted == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // The only client update currently permitted is a one-way soft delete.
      allow update: if signedIn() && validWageEntry(request.resource.data)
        && resource.data.deleted == false && request.resource.data.deleted == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /fishHeadWageVoids/{voidId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'entryId', 'dateKey', 'workerId', 'workerName', 'weightKg',
          'rateRm', 'wageRm', 'voidReason', 'voidedBy', 'voidedAt'
        ])
        && request.resource.data.keys().hasAll([
          'entryId', 'dateKey', 'workerId', 'workerName', 'weightKg',
          'rateRm', 'wageRm', 'voidReason', 'voidedBy', 'voidedAt'
        ])
        && request.resource.data.entryId is string
        && request.resource.data.entryId == voidId
        && request.resource.data.dateKey is string
        && request.resource.data.workerId is string
        && request.resource.data.workerName is string
        && request.resource.data.workerName.size() > 0
        && request.resource.data.workerName.size() <= 100
        && request.resource.data.weightKg is int
        && request.resource.data.weightKg >= 1
        && request.resource.data.weightKg <= 300
        && request.resource.data.rateRm is string
        && request.resource.data.rateRm.matches('^[0-9][.][0-9]{2}$')
        && request.resource.data.wageRm is string
        && request.resource.data.wageRm.matches('^[0-9]+[.][0-9]{2}$')
        && request.resource.data.voidReason is string
        && request.resource.data.voidReason.size() > 0
        && request.resource.data.voidReason.size() <= 100
        && request.resource.data.voidedBy == request.auth.uid
        && request.resource.data.voidedAt == request.time
        && get(
          /databases/$(database)/documents/fishHeadWageEntries/$(voidId)
        ).data.deleted == false
        && getAfter(
          /databases/$(database)/documents/fishHeadWageEntries/$(voidId)
        ).data.deleted == true
        && request.resource.data.dateKey == getAfter(
          /databases/$(database)/documents/fishHeadWageEntries/$(voidId)
        ).data.dateKey
        && request.resource.data.workerId == getAfter(
          /databases/$(database)/documents/fishHeadWageEntries/$(voidId)
        ).data.workerId
        && request.resource.data.workerName == getAfter(
          /databases/$(database)/documents/fishHeadWageEntries/$(voidId)
        ).data.workerName
        && request.resource.data.weightKg == getAfter(
          /databases/$(database)/documents/fishHeadWageEntries/$(voidId)
        ).data.weightKg
        && request.resource.data.rateRm == getAfter(
          /databases/$(database)/documents/fishHeadWageEntries/$(voidId)
        ).data.rateRm
        && request.resource.data.wageRm == getAfter(
          /databases/$(database)/documents/fishHeadWageEntries/$(voidId)
        ).data.wageRm;

      allow update, delete: if false;
    }
  }
}

