rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function uid() { return request.auth.uid; }
    function now() { return request.time; }
    function beforeData(path) { return get(path).data; }
    function afterData(path) { return getAfter(path).data; }
    function signedIn() { return request.auth != null; }
    // Shared lazy accessors keep the compiled rules below the runtime size limit.
    // Calling these preserves the original request/resource availability checks.
    function incomingData() { return request.resource.data; }
    function existingData() { return resource.data; }


    function validRetailAlias(aliases, index) {
      return aliases.size() <= index || aliases[index].matches('^.{1,100}$') && aliases[index] != '黑昌';
    }
    function validRetailFish(data) {
      let aliases = data.get('aliases', []);
      let order = data.get('sortOrder', 0);
      return data.keys().hasOnly(['chineseName', 'malayName', 'suggestedPriceCents', 'active', 'aliases', 'sortOrder', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.chineseName is string && data.chineseName.size() > 0 && data.chineseName.size() <= 100
        && data.malayName is string && data.malayName.size() <= 100
        && (data.suggestedPriceCents == null || (data.suggestedPriceCents is int && data.suggestedPriceCents > 0 && data.suggestedPriceCents <= 1000000))
        && aliases is list && aliases.size() <= 5 && aliases.toSet().size() == aliases.size() && !aliases.hasAny([data.chineseName])
        && validRetailAlias(aliases, 0) && validRetailAlias(aliases, 1) && validRetailAlias(aliases, 2) && validRetailAlias(aliases, 3) && validRetailAlias(aliases, 4)
        && order is int && order >= 0 && order <= 1000000
        && data.active is bool && (data.chineseName != '黑昌' || !data.active) && data.createdBy is string && data.createdAt is timestamp
        && data.updatedBy == uid() && data.updatedAt == now();
    }

    function validRetailLine(line) {
      let deciKg = line.weightDeciKg;
      let price = line.unitPriceCents;
      let amount = line.amountCents;
      return line.keys().hasOnly(['fishId', 'chineseName', 'malayName', 'weightDeciKg', 'unitPriceCents', 'amountCents'])
        && line.fishId.matches('^[^/]{1,100}$')
        && line.chineseName.matches('^.{1,100}$')
        && line.malayName.matches('^.{0,100}$')
        && deciKg is int && deciKg >= 1 && deciKg <= 3000
        && price is int && price > 0 && price <= 1000000
        && amount is int && amount == int((deciKg * price + 5) / 10);
    }

    // Rules cannot iterate lists. Validate every supported slot, including the last.
    function retailAmount(lines, index) { return lines.size() <= index ? 0 : (validRetailLine(lines[index]) ? lines[index].amountCents : null); }
    function validRetailGroup(data) {
      let lines = data.lines;
      return data.keys().hasOnly(['lines', 'totalAmountCents', 'createdAt', 'createdBy'])
        && lines is list && lines.size() <= 5
        && data.createdAt == now() && data.createdBy == uid()
        && data.totalAmountCents is int && data.totalAmountCents == retailAmount(lines, 0) + retailAmount(lines, 1)
          + retailAmount(lines, 2) + retailAmount(lines, 3) + retailAmount(lines, 4);
    }
    function retailGroupPath(saleId, groupId) {
      return /databases/$(database)/documents/retailSales/$(saleId)/groups/$(groupId);
    }
    function retailVesselActive(data) {
      let vessel = beforeData(/databases/$(database)/documents/vessels/$(data.vesselId));
      return data.vesselId.matches('^[^/]{1,80}$') && vessel.active == true
        && data.vesselCodeSnapshot == vessel.vesselCode;
    }
    function validRetailSale(data, saleId) {
      let prefix = data.groupSetId == 'initial' ? '' : data.groupSetId + '_';
      let date = data.businessDate;
      let groups = data.lineGroups;
      let vendor = data.vendorName;
      let first = beforeData(retailGroupPath(saleId, prefix + 'first'));
      let second = beforeData(retailGroupPath(saleId, prefix + 'second'));
      let third = beforeData(retailGroupPath(saleId, prefix + 'third'));
      let fourth = beforeData(retailGroupPath(saleId, prefix + 'fourth'));
      return data.keys().hasOnly(['businessDate', 'dateSortKey', 'vendorName', 'lineGroups', 'totalAmountCents', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt', 'invoiceNumber', 'invoiceSequence', 'revision', 'remark', 'groupSetId', 'lastActionId', 'vesselId', 'vesselCodeSnapshot'])
        && (request.method == 'update' && !data.diff(existingData()).affectedKeys().hasAny(['vesselId', 'vesselCodeSnapshot']) || retailVesselActive(data))
        && date is string && validBusinessDate(date)
        && validWageDateKey(date[6:10] + '-' + date[3:5] + '-' + date[0:2])
        && data.dateSortKey is int && data.dateSortKey == int(date[6:10] + date[3:5] + date[0:2])
        && vendor is string && vendor.size() > 0 && vendor.size() <= 100
        && groups.keys().hasOnly(['first', 'second', 'third', 'fourth'])
        && groups.first == first.lines && groups.second == second.lines
        && groups.third == third.lines && groups.fourth == fourth.lines
        && first.lines.size() > 0
        && first.createdBy == uid() && second.createdBy == uid()
        && third.createdBy == uid() && fourth.createdBy == uid()
        && data.totalAmountCents is int && data.totalAmountCents == first.totalAmountCents + second.totalAmountCents + third.totalAmountCents + fourth.totalAmountCents
        && data.remark is string && data.remark.size() <= 500
        && data.revision is int && data.revision >= 1
        && data.lastActionId.matches('^[A-Za-z0-9_-]{1,100}$')
        && data.updatedBy == uid() && data.updatedAt == now();
    }

    function retailSalePath(id) { return /databases/$(database)/documents/retailSales/$(id); }
    function retailCounterPath(key) { return /databases/$(database)/documents/retailInvoiceCounters/$(key); }
    function retailActionPath(id, action) { return /databases/$(database)/documents/retailSales/$(id)/actions/$(action); }
    function retailEditOpen(data) {
      return data.createdAt is timestamp && now() >= data.createdAt
        && now() < data.createdAt + duration.value(2592000, 's');
    }
    function retailNumber(data) {
      return data.businessDate[0:2] + data.businessDate[3:5] + data.businessDate[6:10]
        + (data.invoiceSequence < 10 ? '00' : data.invoiceSequence < 100 ? '0' : '') + string(data.invoiceSequence);
    }
    function retailAllocated(data, id) {
      let counter = afterData(retailCounterPath(string(data.dateSortKey)));
      return data.createdBy == uid() && data.createdAt == now() && data.revision == 1
          && data.groupSetId == 'initial' && data.lastActionId == id
          && data.invoiceSequence is int && data.invoiceSequence > 0 && data.invoiceNumber == retailNumber(data)
          && counter.lastSaleId == id && counter.lastSequence == data.invoiceSequence && counter.updatedAt == now();
    }
    function retailUpdated(data) {
      let old = existingData();
      return retailEditOpen(old)
          && data.diff(old).affectedKeys().hasOnly(['vendorName', 'lineGroups', 'totalAmountCents', 'remark', 'updatedBy', 'updatedAt', 'revision', 'groupSetId', 'lastActionId', 'vesselId', 'vesselCodeSnapshot'])
          && data.revision == old.get('revision', 1) + 1
          && data.groupSetId == data.lastActionId && data.groupSetId != 'initial';
    }
    function retailHasAction(data, id) {
      let path = retailActionPath(id, data.lastActionId);
      return !exists(path) && afterData(path).afterSnapshot == data;
    }
    function validRetailAction(data, id, action) {
      let path = retailSalePath(id);
      let after = afterData(path);
      return data.keys().hasOnly(['type', 'saleId', 'clientOperationId', 'revision', 'beforeSnapshot', 'afterSnapshot', 'performedBy', 'performedAt'])
        && data.saleId == id && data.clientOperationId == action && after.lastActionId == action
        && data.revision == after.revision && data.afterSnapshot == after
        && data.performedBy == uid() && data.performedAt == now() && after.updatedAt == now()
        && (exists(path) ? data.type == 'update' && data.beforeSnapshot == beforeData(path)
          && after.revision == beforeData(path).get('revision', 1) + 1
          : data.type == 'create' && data.beforeSnapshot == null && after.revision == 1);
    }
    function validRetailCounter(data, key) {
      let path = retailSalePath(data.lastSaleId);
      let sale = afterData(path);
      return data.keys().hasOnly(['dateSortKey', 'lastSequence', 'lastSaleId', 'updatedBy', 'updatedAt'])
        && data.dateSortKey is int && string(data.dateSortKey) == key
        && data.lastSequence is int && data.lastSequence > 0
        && data.lastSaleId.matches('^[A-Za-z0-9_-]{1,100}$')
        && data.updatedBy == uid() && data.updatedAt == now()
        && !exists(path) && sale.dateSortKey == data.dateSortKey && sale.invoiceSequence == data.lastSequence
        && sale.createdAt == now()
        && data.lastSequence == (request.method == 'create' ? 1 : existingData().lastSequence + 1);
    }

    match /retailFish/{fishId} {
      allow read: if signedIn();
      allow create: if signedIn() && validRetailFish(incomingData())
        && incomingData().chineseName != '黑昌'
        && incomingData().createdBy == uid() && incomingData().createdAt == now();
      allow update: if signedIn() && validRetailFish(incomingData())
        && incomingData().createdBy == existingData().createdBy && incomingData().createdAt == existingData().createdAt;
      allow delete: if false;
    }
    match /retailSales/{saleId} {
      allow read: if signedIn();
      // Immutable prepared groups are validated separately within the expression
      // budget. Only this final atomic document appears as a completed sale.
      allow create, update: if signedIn() && validRetailSale(incomingData(), saleId)
        && (request.method == 'create' ? retailAllocated(incomingData(), saleId) : retailUpdated(incomingData()))
        && retailHasAction(incomingData(), saleId);
      allow delete: if false;
      match /groups/{groupId} {
        allow read: if signedIn();
        allow create: if signedIn() && groupId.matches('^([A-Za-z0-9_-]{1,100}_)?(first|second|third|fourth)$')
          && validRetailGroup(incomingData());
        allow update, delete: if false;
      }
      match /actions/{actionId} {
        allow read: if signedIn();
        allow create: if signedIn() && validRetailAction(incomingData(), saleId, actionId);
        allow update, delete: if false;
      }
    }
    match /retailInvoiceCounters/{dateKey} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validRetailCounter(incomingData(), dateKey);
      allow delete: if false;
    }

    function monthPath(monthKey) {
      return /databases/$(database)/documents/fishHeadWageMonths/$(monthKey);
    }

    function monthKeyForDate(dateKey) { return dateKey[0:7]; }

    function monthOpenAfter(dateKey) {
      let path = monthPath(monthKeyForDate(dateKey));
      return !existsAfter(path)
        || (afterData(path).status == 'open' && afterData(path).closingToken == null);
    }

    function actionPath(monthKey, actionId) {
      return /databases/$(database)/documents/fishHeadWageMonths/$(monthKey)/actions/$(actionId);
    }

    function paymentPath(monthKey, paymentId) {
      return /databases/$(database)/documents/fishHeadWageMonths/$(monthKey)/payments/$(paymentId);
    }

    function statementPath(monthKey, statementId) {
      return /databases/$(database)/documents/fishHeadWageMonths/$(monthKey)/statements/$(statementId);
    }

    function validWorker(data) {
      return data.keys().hasOnly([
          'name', 'active', 'order', 'workerCode', 'phone', 'department', 'workerDepartment',
          'employmentStartDate', 'employmentEndDate', 'notes',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'inactiveBy', 'inactiveAt'
        ])
        && data.keys().hasAll(['name', 'active', 'order'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.active is bool
        && data.order is int && data.order >= 0
        && (!('workerCode' in data) || (data.workerCode is string && data.workerCode.matches('^WK-[A-Z0-9]{8}$')))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('department' in data) || (data.department is string && data.department.size() > 0 && data.department.size() <= 50))
        && (!('workerDepartment' in data) || data.workerDepartment in ['fish_head_cutting', 'ccm_general', 'other'])
        && (!('employmentStartDate' in data) || (data.employmentStartDate is string
          && (data.employmentStartDate == '' || data.employmentStartDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))))
        && (!('employmentEndDate' in data) || (data.employmentEndDate is string
          && (data.employmentEndDate == '' || data.employmentEndDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))))
        && (!('employmentStartDate' in data) || !('employmentEndDate' in data)
          || data.employmentStartDate == '' || data.employmentEndDate == ''
          || data.employmentEndDate >= data.employmentStartDate)
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('createdBy' in data) || data.createdBy is string)
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedBy' in data) || data.updatedBy is string)
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (!('inactiveBy' in data) || data.inactiveBy == null || data.inactiveBy is string)
        && (!('inactiveAt' in data) || data.inactiveAt == null || data.inactiveAt is timestamp);
    }

    function validPartner(data) {
      return data.keys().hasOnly([
          'partnerCode', 'displayName', 'legalName', 'supplier', 'customer', 'active',
          'phone', 'registrationNo', 'paymentTermsDays', 'notes',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'inactiveBy', 'inactiveAt'
        ])
        && data.keys().hasAll([
          'partnerCode', 'displayName', 'legalName', 'supplier', 'customer', 'active',
          'phone', 'registrationNo', 'paymentTermsDays', 'notes',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'inactiveBy', 'inactiveAt'
        ])
        && data.partnerCode is string && data.partnerCode.matches('^BP-[A-Z0-9]{8}$')
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 80
        && data.legalName is string && data.legalName.size() <= 120
        && data.supplier is bool && data.customer is bool && (data.supplier || data.customer)
        && data.active is bool
        && data.phone is string && data.phone.size() <= 30
        && data.registrationNo is string && data.registrationNo.size() <= 50
        && data.paymentTermsDays is int && data.paymentTermsDays >= 0 && data.paymentTermsDays <= 365
        && data.notes is string && data.notes.size() <= 500
        && data.createdBy is string && data.createdAt is timestamp
        && data.updatedBy is string && data.updatedAt is timestamp
        && (data.inactiveBy == null || data.inactiveBy is string)
        && (data.inactiveAt == null || data.inactiveAt is timestamp)
        && ((data.active && data.inactiveBy == null && data.inactiveAt == null)
          || (!data.active && data.inactiveBy is string && data.inactiveAt is timestamp));
    }

    function purchaseReceiptPath(receiptId) {
      return /databases/$(database)/documents/purchaseReceipts/$(receiptId);
    }

    function purchaseActionPath(receiptId, actionId) {
      return /databases/$(database)/documents/purchaseReceipts/$(receiptId)/actions/$(actionId);
    }

    function purchasePaymentPath(paymentId) {
      return /databases/$(database)/documents/purchasePayments/$(paymentId);
    }

    function validPurchaseCategory(data) {
      return data.keys().hasOnly([
          'categoryCode', 'displayName', 'active', 'order', 'notes',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'inactiveBy', 'inactiveAt'
        ])
        && data.keys().hasAll([
          'categoryCode', 'displayName', 'active', 'order', 'notes',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'inactiveBy', 'inactiveAt'
        ])
        && data.categoryCode is string && data.categoryCode.matches('^[a-z0-9_]{1,40}$')
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.active is bool && data.order is int && data.order >= 0
        && data.notes is string && data.notes.size() <= 500
        && data.createdBy is string && data.createdAt is timestamp
        && data.updatedBy is string && data.updatedAt is timestamp
        && (data.inactiveBy == null || data.inactiveBy is string)
        && (data.inactiveAt == null || data.inactiveAt is timestamp);
    }

    function validVessel(data) {
      return data.keys().hasOnly([
          'vesselCode', 'displayName', 'defaultSupplierId', 'defaultSupplierNameSnapshot',
          'active', 'order', 'notes', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'inactiveBy', 'inactiveAt'
        ])
        && data.keys().hasAll([
          'vesselCode', 'displayName', 'defaultSupplierId', 'defaultSupplierNameSnapshot',
          'active', 'order', 'notes', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'inactiveBy', 'inactiveAt'
        ])
        && data.vesselCode is string && data.vesselCode.size() >= 1 && data.vesselCode.size() <= 30
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.defaultSupplierId is string && data.defaultSupplierNameSnapshot is string
        && data.active is bool && data.order is int && data.order >= 0 && data.notes is string && data.notes.size() <= 500
        && data.createdBy is string && data.createdAt is timestamp
        && data.updatedBy is string && data.updatedAt is timestamp
        && (data.inactiveBy == null || data.inactiveBy is string)
        && (data.inactiveAt == null || data.inactiveAt is timestamp);
    }

    function validBusinessDate(value) {
      return value is string && value.matches('^[0-9]{2}/[0-9]{2}/[0-9]{4}$');
    }

    function validIceWorkRecord(data) {
      return data.workDate is string && validBusinessDate(data.workDate)
        && data.monthKey is string && data.monthKey.matches('^[0-9]{2}/[0-9]{4}$') && data.monthKey == data.workDate[3:10]
        && data.dateSortKey is int && data.dateSortKey == int(data.workDate[6:10] + data.workDate[3:5] + data.workDate[0:2])
        && data.monthSortKey is int && data.monthSortKey == int(data.monthKey[3:7] + data.monthKey[0:2])
        && data.vesselId is string && data.vesselCodeSnapshot is string && data.vesselNameSnapshot is string
        && data.factoryIncomingWeightGrams is int && data.factoryIncomingWeightGrams >= 0 && data.factoryIncomingWeightGrams <= 300000 && data.factoryIncomingWeightGrams % 1000 == 0
        && data.iceBoxHalfUnits is int && data.iceBoxHalfUnits >= 0
        && data.dieselVolumeMilliliters is int && data.dieselVolumeMilliliters >= 0
        && data.hawkerSaleWeightGrams is int && data.hawkerSaleWeightGrams >= 0 && data.hawkerSaleWeightGrams <= 300000 && data.hawkerSaleWeightGrams % 1000 == 0
        && data.directIceBarCount is int && data.directIceBarCount >= 0 && data.plasticBagCount is int && data.plasticBagCount >= 0
        && data.factoryIncomingRateCentsPerKg == 10 && data.iceBoxRateCentsPerFullBox == 3000 && data.iceBoxRateCentsPerHalfUnit == 1500
        && data.dieselRateCentsPerLiter == 2 && data.hawkerSaleRateCentsPerKg == 30 && data.directIceRateCentsPerBar == 1350 && data.plasticBagRateCentsEach == 140
        && data.factoryIncomingAmountCents == int((data.factoryIncomingWeightGrams * 10 + 500) / 1000)
        && data.iceBoxAmountCents == data.iceBoxHalfUnits * 1500
        && data.dieselAmountCents == int((data.dieselVolumeMilliliters * 2 + 500) / 1000)
        && data.hawkerSaleAmountCents == int((data.hawkerSaleWeightGrams * 30 + 500) / 1000)
        && data.directIceAmountCents == data.directIceBarCount * 1350 && data.plasticBagAmountCents == data.plasticBagCount * 140
        && data.workFeeSubtotalCents == data.factoryIncomingAmountCents + data.iceBoxAmountCents + data.dieselAmountCents + data.hawkerSaleAmountCents
        && data.materialSubtotalCents == data.directIceAmountCents + data.plasticBagAmountCents && data.recordTotalCents == data.workFeeSubtotalCents + data.materialSubtotalCents
        && data.status in ['draft','confirmed','reopened','voided'] && data.revision is int && data.revision >= 1 && data.voided is bool
        && data.notes is string && data.notes.size() <= 500 && data.createdBy is string && data.createdAt is timestamp && data.updatedBy is string && data.updatedAt is timestamp
        && data.lastActionId is string && data.lastActionId.size() > 0;
    }

    function validIceWorkSettlement(data) {
      return data.keys().hasOnly(['vesselId', 'vesselCodeSnapshot', 'monthKey', 'monthSortKey', 'validRecordCount',
          'factoryIncomingAmountCents', 'iceBoxAmountCents', 'dieselAmountCents', 'hawkerSaleAmountCents', 'directIceAmountCents', 'plasticBagAmountCents',
          'workFeeSubtotalCents', 'materialSubtotalCents', 'recordsTotalCents', 'headmanFeeCents', 'clerkFeeCents', 'finalTotalCents',
          'status', 'revision', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'confirmedBy', 'confirmedAt',
          'reopenedBy', 'reopenedAt', 'reopenReason', 'voidedBy', 'voidedAt', 'voidReason', 'lastActionId'])
        && data.keys().hasAll(['vesselId', 'vesselCodeSnapshot', 'monthKey', 'monthSortKey', 'validRecordCount',
          'factoryIncomingAmountCents', 'iceBoxAmountCents', 'dieselAmountCents', 'hawkerSaleAmountCents', 'directIceAmountCents', 'plasticBagAmountCents',
          'workFeeSubtotalCents', 'materialSubtotalCents', 'recordsTotalCents', 'headmanFeeCents', 'clerkFeeCents', 'finalTotalCents',
          'status', 'revision', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'confirmedBy', 'confirmedAt',
          'reopenedBy', 'reopenedAt', 'reopenReason', 'voidedBy', 'voidedAt', 'voidReason', 'lastActionId'])
        && data.vesselId is string && data.vesselCodeSnapshot is string && data.monthKey is string && data.monthKey.matches('^[0-9]{2}/[0-9]{4}$') && data.monthSortKey is int
        && data.monthSortKey == int(data.monthKey[3:7] + data.monthKey[0:2])
        && data.validRecordCount is int && data.validRecordCount >= 0
        && data.factoryIncomingAmountCents is int && data.factoryIncomingAmountCents >= 0 && data.iceBoxAmountCents is int && data.iceBoxAmountCents >= 0
        && data.dieselAmountCents is int && data.dieselAmountCents >= 0 && data.hawkerSaleAmountCents is int && data.hawkerSaleAmountCents >= 0
        && data.directIceAmountCents is int && data.directIceAmountCents >= 0 && data.plasticBagAmountCents is int && data.plasticBagAmountCents >= 0
        && data.workFeeSubtotalCents == data.factoryIncomingAmountCents + data.iceBoxAmountCents + data.dieselAmountCents + data.hawkerSaleAmountCents
        && data.materialSubtotalCents == data.directIceAmountCents + data.plasticBagAmountCents && data.recordsTotalCents == data.workFeeSubtotalCents + data.materialSubtotalCents
        && data.headmanFeeCents == 50000 && data.clerkFeeCents == 25000 && data.finalTotalCents == data.recordsTotalCents + data.headmanFeeCents + data.clerkFeeCents
        && data.status in ['draft', 'confirmed', 'reopened', 'voided'] && data.revision is int && data.revision >= 1
        && data.createdBy is string && data.createdAt is timestamp && data.updatedBy is string && data.updatedAt is timestamp
        && data.lastActionId is string && data.lastActionId.size() > 0
        && (data.confirmedBy == null || data.confirmedBy is string) && (data.confirmedAt == null || data.confirmedAt is timestamp)
        && (data.reopenedBy == null || data.reopenedBy is string) && (data.reopenedAt == null || data.reopenedAt is timestamp)
        && (data.reopenReason == null || (data.reopenReason is string && data.reopenReason.size() >= 2 && data.reopenReason.size() <= 500))
        && (data.voidedBy == null || data.voidedBy is string) && (data.voidedAt == null || data.voidedAt is timestamp)
        && (data.voidReason == null || (data.voidReason is string && data.voidReason.size() >= 2 && data.voidReason.size() <= 500));
    }

    function iceWorkRecordSnapshotMatches(data, snapshot) {
      return snapshot is map && snapshot.id is string && snapshot.workDate == data.workDate && snapshot.monthKey == data.monthKey
        && snapshot.dateSortKey == data.dateSortKey && snapshot.monthSortKey == data.monthSortKey
        && snapshot.vesselId == data.vesselId && snapshot.vesselCodeSnapshot == data.vesselCodeSnapshot && snapshot.vesselNameSnapshot == data.vesselNameSnapshot
        && snapshot.factoryIncomingWeightGrams == data.factoryIncomingWeightGrams && snapshot.factoryIncomingRateCentsPerKg == data.factoryIncomingRateCentsPerKg
        && snapshot.iceBoxHalfUnits == data.iceBoxHalfUnits && snapshot.iceBoxRateCentsPerFullBox == data.iceBoxRateCentsPerFullBox && snapshot.iceBoxRateCentsPerHalfUnit == data.iceBoxRateCentsPerHalfUnit
        && snapshot.dieselVolumeMilliliters == data.dieselVolumeMilliliters && snapshot.dieselRateCentsPerLiter == data.dieselRateCentsPerLiter
        && snapshot.hawkerSaleWeightGrams == data.hawkerSaleWeightGrams && snapshot.hawkerSaleRateCentsPerKg == data.hawkerSaleRateCentsPerKg
        && snapshot.directIceBarCount == data.directIceBarCount && snapshot.directIceRateCentsPerBar == data.directIceRateCentsPerBar
        && snapshot.plasticBagCount == data.plasticBagCount && snapshot.plasticBagRateCentsEach == data.plasticBagRateCentsEach
        && snapshot.factoryIncomingAmountCents == data.factoryIncomingAmountCents && snapshot.iceBoxAmountCents == data.iceBoxAmountCents
        && snapshot.dieselAmountCents == data.dieselAmountCents && snapshot.hawkerSaleAmountCents == data.hawkerSaleAmountCents
        && snapshot.directIceAmountCents == data.directIceAmountCents && snapshot.plasticBagAmountCents == data.plasticBagAmountCents
        && snapshot.workFeeSubtotalCents == data.workFeeSubtotalCents && snapshot.materialSubtotalCents == data.materialSubtotalCents
        && snapshot.recordTotalCents == data.recordTotalCents && snapshot.notes == data.notes && snapshot.status == data.status
        && snapshot.revision == data.revision && snapshot.voided == data.voided && snapshot.voidReason == data.voidReason && snapshot.lastActionId == data.lastActionId;
    }

    function iceWorkSettlementSnapshotMatches(data, snapshot) {
      return snapshot is map && snapshot.id is string && snapshot.vesselId == data.vesselId && snapshot.vesselCodeSnapshot == data.vesselCodeSnapshot
        && snapshot.monthKey == data.monthKey && snapshot.monthSortKey == data.monthSortKey && snapshot.validRecordCount == data.validRecordCount
        && snapshot.factoryIncomingAmountCents == data.factoryIncomingAmountCents && snapshot.iceBoxAmountCents == data.iceBoxAmountCents
        && snapshot.dieselAmountCents == data.dieselAmountCents && snapshot.hawkerSaleAmountCents == data.hawkerSaleAmountCents
        && snapshot.directIceAmountCents == data.directIceAmountCents && snapshot.plasticBagAmountCents == data.plasticBagAmountCents
        && snapshot.workFeeSubtotalCents == data.workFeeSubtotalCents && snapshot.materialSubtotalCents == data.materialSubtotalCents
        && snapshot.recordsTotalCents == data.recordsTotalCents && snapshot.headmanFeeCents == data.headmanFeeCents
        && snapshot.clerkFeeCents == data.clerkFeeCents && snapshot.finalTotalCents == data.finalTotalCents
        && snapshot.status == data.status && snapshot.revision == data.revision && snapshot.lastActionId == data.lastActionId;
    }

    function validIceWorkRecordAction(recordId, actionId, expectedType, expectedRevision) {
      let action = afterData(/databases/$(database)/documents/iceWorkRecords/$(recordId)/actions/$(actionId));
      return existsAfter(/databases/$(database)/documents/iceWorkRecords/$(recordId)/actions/$(actionId))
        && action.type == expectedType && action.recordId == recordId
        && action.clientOperationId == actionId && action.performedBy == uid()
        && action.performedAt == now() && action.revision == expectedRevision;
    }

    function validIceWorkSettlementAction(settlementId, actionId, expectedType, expectedRevision) {
      let action = afterData(/databases/$(database)/documents/iceWorkMonthlySettlements/$(settlementId)/actions/$(actionId));
      return existsAfter(/databases/$(database)/documents/iceWorkMonthlySettlements/$(settlementId)/actions/$(actionId))
        && action.type == expectedType && action.settlementId == settlementId
        && action.clientOperationId == actionId && action.performedBy == uid()
        && action.performedAt == now() && action.revision == expectedRevision;
    }

    function validPurchaseReceipt(data) {
      return data.keys().hasOnly([
          'receiptCode', 'receiptDate', 'monthKey', 'externalSlipNo',
          'supplierId', 'supplierCodeSnapshot', 'supplierNameSnapshot',
          'vesselId', 'vesselCodeSnapshot', 'vesselNameSnapshot', 'status',
          'lineCount', 'totalBasketCount', 'totalWeightGrams', 'totalAmountCents',
          'paidCents', 'paymentStatus', 'notes', 'duplicateAcknowledged',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'lastActionId',
          'confirmedBy', 'confirmedAt', 'voidedBy', 'voidedAt', 'voidReason',
          'lineIds', 'draftVersion', 'sourceWeighingSessionId'
        ])
        && data.keys().hasAll([
          'receiptCode', 'receiptDate', 'monthKey', 'externalSlipNo',
          'supplierId', 'supplierCodeSnapshot', 'supplierNameSnapshot',
          'vesselId', 'vesselCodeSnapshot', 'vesselNameSnapshot', 'status',
          'lineCount', 'totalBasketCount', 'totalWeightGrams', 'totalAmountCents',
          'paidCents', 'paymentStatus', 'notes', 'duplicateAcknowledged',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'lastActionId',
          'confirmedBy', 'confirmedAt', 'voidedBy', 'voidedAt', 'voidReason',
          'lineIds', 'draftVersion', 'sourceWeighingSessionId'
        ])
        && data.receiptCode is string && data.receiptCode.matches('^RC-[A-Z0-9]{8}$')
        && data.receiptDate is string
        && ((data.receiptDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.monthKey == data.receiptDate[0:7])
          || (data.receiptDate.matches('^[0-9]{2}/[0-9]{2}/[0-9]{4}$') && data.monthKey == data.receiptDate[3:10]))
        && data.externalSlipNo is string && data.externalSlipNo.size() <= 100
        && data.supplierId is string && data.supplierId.size() > 0
        && data.supplierCodeSnapshot is string && data.supplierNameSnapshot is string && data.supplierNameSnapshot.size() > 0
        && data.vesselId is string && data.vesselId.size() > 0
        && data.vesselCodeSnapshot is string && data.vesselNameSnapshot is string
        && data.status in ['draft', 'confirmed', 'voided']
        && data.lineCount is int && data.lineCount >= 0
        && data.lineIds is list && data.lineIds.size() == data.lineCount && data.lineIds.size() <= 100
        && data.draftVersion is int && data.draftVersion >= 1
        && data.totalBasketCount is int && data.totalBasketCount >= 0
        && data.totalWeightGrams is int && data.totalWeightGrams >= 0
        && data.totalAmountCents is int && data.totalAmountCents >= 0
        && data.paidCents is int && data.paidCents >= 0 && data.paidCents <= data.totalAmountCents
        && data.paymentStatus in ['unpaid', 'partial', 'paid']
        && ((data.paidCents == 0 && data.paymentStatus == 'unpaid')
          || (data.paidCents > 0 && data.paidCents < data.totalAmountCents && data.paymentStatus == 'partial')
          || (data.totalAmountCents > 0 && data.paidCents == data.totalAmountCents && data.paymentStatus == 'paid'))
        && data.notes is string && data.notes.size() <= 500 && data.duplicateAcknowledged is bool
        && data.createdBy is string && data.createdAt is timestamp
        && data.updatedBy is string && data.updatedAt is timestamp
        && data.lastActionId is string && data.lastActionId.size() > 0
        && (data.sourceWeighingSessionId == null || data.sourceWeighingSessionId is string)
        && (data.confirmedBy == null || data.confirmedBy is string)
        && (data.confirmedAt == null || data.confirmedAt is timestamp)
        && (data.voidedBy == null || data.voidedBy is string)
        && (data.voidedAt == null || data.voidedAt is timestamp)
        && (data.voidReason == null || (data.voidReason is string && data.voidReason.size() >= 3 && data.voidReason.size() <= 100));
    }

    function validActivePurchaseParties(data) {
      let supplier = beforeData(/databases/$(database)/documents/businessPartners/$(data.supplierId));
      let vessel = beforeData(/databases/$(database)/documents/vessels/$(data.vesselId));
      return supplier.active == true && supplier.supplier == true
        && supplier.partnerCode == data.supplierCodeSnapshot
        && supplier.displayName == data.supplierNameSnapshot
        && vessel.active == true
        && vessel.vesselCode == data.vesselCodeSnapshot
        && vessel.displayName == data.vesselNameSnapshot;
    }

    function validPurchaseLine(data) {
      return data.keys().hasOnly([
          'lineNo', 'categoryId', 'categoryCodeSnapshot', 'categoryNameSnapshot',
          'basketCount', 'weightGrams', 'unitPriceCentsPerKg', 'amountCents',
          'notes', 'createdAt', 'updatedAt', 'sourceWeighingSessionId',
          'productType', 'fishSpeciesCode', 'fishMealQuality'
        ])
        && data.keys().hasAll([
          'lineNo', 'categoryId', 'categoryCodeSnapshot', 'categoryNameSnapshot',
          'basketCount', 'weightGrams', 'unitPriceCentsPerKg', 'amountCents',
          'notes', 'createdAt', 'updatedAt', 'sourceWeighingSessionId',
          'productType', 'fishSpeciesCode', 'fishMealQuality'
        ])
        && data.lineNo is int && data.lineNo >= 1
        && data.categoryId is string && data.categoryId.size() > 0
        && data.categoryCodeSnapshot is string && data.categoryNameSnapshot is string && data.categoryNameSnapshot.size() > 0
        && data.basketCount is int && data.basketCount >= 0 && data.basketCount <= 9999
        && data.weightGrams is int && data.weightGrams > 0 && data.weightGrams <= 100000000
        && data.unitPriceCentsPerKg is int && data.unitPriceCentsPerKg > 0 && data.unitPriceCentsPerKg <= 10000000
        && data.amountCents is int && data.amountCents > 0
        && data.amountCents == int((data.weightGrams * data.unitPriceCentsPerKg + 500) / 1000)
        && data.notes is string && data.notes.size() <= 500
        && (data.sourceWeighingSessionId == null || data.sourceWeighingSessionId is string)
        && (data.productType == null || data.productType in ['fish_head', 'fish_meal'])
        && (data.fishSpeciesCode == null || data.fishSpeciesCode is string)
        && (data.fishMealQuality == null || data.fishMealQuality in ['bucket', 'bag'])
        && ((data.sourceWeighingSessionId == null
            && data.productType == null && data.fishSpeciesCode == null && data.fishMealQuality == null)
          || (data.sourceWeighingSessionId is string
            && ((data.productType == 'fish_head' && data.fishSpeciesCode is string && data.fishMealQuality == null)
              || (data.productType == 'fish_meal' && data.fishSpeciesCode == null
                && data.fishMealQuality in ['bucket', 'bag']))))
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validPurchasePayment(data) {
      return data.keys().hasOnly([
          'paymentGroupId', 'receiptId', 'receiptCode', 'supplierId', 'supplierNameSnapshot',
          'amountCents', 'method', 'paymentDate', 'reference', 'note',
          'createdBy', 'createdAt', 'voided', 'voidReason', 'voidedBy', 'voidedAt'
        ])
        && data.keys().hasAll([
          'paymentGroupId', 'receiptId', 'receiptCode', 'supplierId', 'supplierNameSnapshot',
          'amountCents', 'method', 'paymentDate', 'reference', 'note',
          'createdBy', 'createdAt', 'voided', 'voidReason', 'voidedBy', 'voidedAt'
        ])
        && data.paymentGroupId is string && data.paymentGroupId.size() > 0
        && data.receiptId is string && data.receiptId.size() > 0
        && data.receiptCode is string && data.supplierId is string && data.supplierNameSnapshot is string
        && data.amountCents is int && data.amountCents > 0
        && data.method in ['cash', 'bank', 'other']
        && data.paymentDate is string && data.paymentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.reference is string && data.reference.size() <= 100
        && data.note is string && data.note.size() <= 500
        && data.createdBy is string && data.createdAt is timestamp && data.voided is bool
        && (data.voidReason == null || (data.voidReason is string && data.voidReason.size() >= 3 && data.voidReason.size() <= 100))
        && (data.voidedBy == null || data.voidedBy is string)
        && (data.voidedAt == null || data.voidedAt is timestamp);
    }

    function validPurchaseAction(data) {
      return data.keys().hasOnly([
          'type', 'receiptId', 'receiptCode', 'supplierId', 'vesselId', 'paymentId',
          'reason', 'performedBy', 'performedAt', 'beforeSnapshot', 'afterSnapshot'
        ])
        && data.keys().hasAll([
          'type', 'receiptId', 'receiptCode', 'supplierId', 'vesselId', 'performedBy', 'performedAt'
        ])
        && data.type in ['create', 'update_draft', 'confirm', 'void', 'payment_create', 'payment_void']
        && data.receiptId is string && data.receiptCode is string
        && data.supplierId is string && data.vesselId is string
        && data.performedBy == uid() && data.performedAt == now()
        && (!('paymentId' in data) || data.paymentId is string)
        && (!('reason' in data) || (data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 100))
        && 'afterSnapshot' in data;
    }

    // Settlement drafts are editable, non-authoritative working data. The client
    // domain layer validates each line; Firestore Rules keeps the compact state
    // guard here because the backend compiler has a strict expression budget.
    function validPurchaseSettlementDraft(data) {
      return data.keys().hasOnly([
          'productType', 'businessDate', 'dateSortKey', 'monthKey', 'monthSortKey',
          'vesselId', 'vesselCodeSnapshot', 'receiptNo', 'status', 'lines',
          'totalAmountCents', 'sourceEntryIds', 'createdAt', 'createdBy',
          'updatedAt', 'updatedBy', 'revision', 'voided', 'voidReason',
          'voidedBy', 'voidedAt', 'sourceSessionId', 'sourceSessionRevision'
        ])
        && data.keys().hasAll([
          'productType', 'businessDate', 'dateSortKey', 'monthKey', 'monthSortKey',
          'vesselId', 'vesselCodeSnapshot', 'receiptNo', 'status', 'lines',
          'totalAmountCents', 'sourceEntryIds', 'createdAt', 'createdBy',
          'updatedAt', 'updatedBy', 'revision', 'voided'
        ])
        && data.productType in ['fish_head', 'fish_meal']
        && data.businessDate is string && data.businessDate.size() >= 8 && data.businessDate.size() <= 10
        && data.dateSortKey is int && data.dateSortKey >= 20200101
        && data.monthKey is string && data.monthKey.size() >= 7 && data.monthKey.size() <= 7
        && data.monthSortKey is int && data.monthSortKey >= 202001
        && data.vesselId is string && data.vesselId.size() > 0 && data.vesselId.size() <= 80
        && data.vesselCodeSnapshot is string && data.vesselCodeSnapshot.size() > 0 && data.vesselCodeSnapshot.size() <= 30
        && data.receiptNo is string && data.receiptNo.size() <= 100
        && data.status == 'settlement_draft'
        && data.lines is list && data.lines.size() <= 100
        && data.totalAmountCents is int && data.totalAmountCents >= 0
        && data.sourceEntryIds is list && data.sourceEntryIds.size() > 0 && data.sourceEntryIds.size() <= 500
        && data.createdBy is string && data.createdAt is timestamp
        && data.updatedBy is string && data.updatedAt is timestamp
        && data.revision is int && data.revision >= 1
        && data.voided is bool
        && ((data.voided == false
            && (!('voidReason' in data) || data.voidReason == null)
            && (!('voidedBy' in data) || data.voidedBy == null)
            && (!('voidedAt' in data) || data.voidedAt == null))
          || (data.voided == true
            && data.voidReason is string && data.voidReason.size() >= 3 && data.voidReason.size() <= 100
            && data.voidedBy is string && data.voidedAt is timestamp));
    }

    function validPurchaseSettlementDraftUpdate() {
      return validPurchaseSettlementDraft(incomingData())
        && incomingData().productType == existingData().productType
        && incomingData().createdBy == existingData().createdBy
        && incomingData().createdAt == existingData().createdAt
        && incomingData().updatedBy == uid()
        && incomingData().updatedAt == now()
        && incomingData().revision == existingData().revision + 1
        && ((existingData().voided == false && incomingData().voided == false)
          || (existingData().voided == false && incomingData().voided == true
            && incomingData().diff(existingData()).affectedKeys().hasOnly([
              'voided', 'voidReason', 'voidedBy', 'voidedAt', 'updatedBy', 'updatedAt', 'revision'
            ])
            && incomingData().voidedBy == uid()
            && incomingData().voidedAt == now()));
    }

    function validSettlementSource() {
      let data = incomingData();
      let source = afterData(weighingSessionPath(data.sourceSessionId));
      return data.sourceSessionId is string && data.sourceSessionRevision == source.revision
        && source.productType == data.productType && source.vesselId == data.vesselId
        && source.vesselCodeSnapshot == data.vesselCodeSnapshot
        && validBusinessDate(data.businessDate)
        && data.dateSortKey == int(data.businessDate[6:10] + data.businessDate[3:5] + data.businessDate[0:2])
        && data.monthKey == data.businessDate[3:10]
        && data.monthSortKey == int(data.businessDate[6:10] + data.businessDate[3:5])
        && (source.weighingDate == data.businessDate
          || source.weighingDate == data.businessDate[6:10] + '-' + data.businessDate[3:5] + '-' + data.businessDate[0:2])
        && weighingCanModify(source);
    }

    function settlementSourcePath(data) {
      return /databases/$(database)/documents/purchaseSettlementSources/$(data.productType + '_session_' + data.sourceSessionId);
    }

    function validSettlementLegacyBinding() {
      let entry = beforeData(weighingEntryPath(incomingData().sourceSessionId, existingData().sourceEntryIds[0]));
      return entry.sessionId == incomingData().sourceSessionId
        && entry.productType == incomingData().productType
        && entry.recordedAt is timestamp && entry.recordedAt <= existingData().createdAt;
    }

    function validSettlementAudit(draftId) {
      let action = afterData(/databases/$(database)/documents/purchaseSettlementDrafts/$(draftId)/actions/$(string(incomingData().revision)));
      return action.afterSnapshot == incomingData()
        && action.beforeSnapshot == (exists(/databases/$(database)/documents/purchaseSettlementDrafts/$(draftId)) ? existingData() : null)
        && action.performedBy == uid() && action.performedAt == now();
    }

    function validLinkedPurchaseAction(receiptId, actionType) {
      let actionId = afterData(purchaseReceiptPath(receiptId)).lastActionId;
      let action = afterData(purchaseActionPath(receiptId, actionId));
      return existsAfter(purchaseActionPath(receiptId, actionId))
        && action.type == actionType && action.receiptId == receiptId
        && action.receiptCode == afterData(purchaseReceiptPath(receiptId)).receiptCode
        && action.supplierId == afterData(purchaseReceiptPath(receiptId)).supplierId
        && action.vesselId == afterData(purchaseReceiptPath(receiptId)).vesselId
        && action.performedBy == uid() && action.performedAt == now();
    }

    function validPurchaseReceiptPaymentUpdate(receiptId) {
      let receipt = afterData(purchaseReceiptPath(receiptId));
      let action = afterData(purchaseActionPath(receiptId, receipt.lastActionId));
      let payment = afterData(purchasePaymentPath(action.paymentId));
      return validLinkedPurchaseAction(receiptId, action.type)
        && action.paymentId is string
        && existsAfter(purchasePaymentPath(action.paymentId))
        && payment.receiptId == receiptId
        && (
          (action.type == 'payment_create'
            && payment.voided == false
            && receipt.paidCents == existingData().paidCents + payment.amountCents)
          ||
          (action.type == 'payment_void'
            && payment.voided == true
            && receipt.paidCents == existingData().paidCents - payment.amountCents)
        )
        && action.afterSnapshot.paidCents == receipt.paidCents
        && action.afterSnapshot.paymentStatus == receipt.paymentStatus;
    }

    function validDraftPurchaseAction(receiptId, actionType) {
      let receipt = afterData(purchaseReceiptPath(receiptId));
      let action = afterData(purchaseActionPath(receiptId, receipt.lastActionId));
      return validLinkedPurchaseAction(receiptId, actionType)
        && action.afterSnapshot.status == 'draft'
        && action.afterSnapshot.draftVersion == receipt.draftVersion
        && action.afterSnapshot.lineCount == receipt.lineCount
        && action.afterSnapshot.totalBasketCount == receipt.totalBasketCount
        && action.afterSnapshot.totalWeightGrams == receipt.totalWeightGrams
        && action.afterSnapshot.totalAmountCents == receipt.totalAmountCents;
    }

    function validConfirmPurchaseAction(receiptId) {
      let receipt = afterData(purchaseReceiptPath(receiptId));
      let action = afterData(purchaseActionPath(receiptId, receipt.lastActionId));
      return validLinkedPurchaseAction(receiptId, 'confirm')
        && action.afterSnapshot.status == 'confirmed'
        && action.afterSnapshot.lineCount == receipt.lineCount
        && action.afterSnapshot.totalBasketCount == receipt.totalBasketCount
        && action.afterSnapshot.totalWeightGrams == receipt.totalWeightGrams
        && action.afterSnapshot.totalAmountCents == receipt.totalAmountCents;
    }

    function validVoidPurchaseAction(receiptId) {
      let receipt = afterData(purchaseReceiptPath(receiptId));
      let action = afterData(purchaseActionPath(receiptId, receipt.lastActionId));
      return validLinkedPurchaseAction(receiptId, 'void')
        && action.reason == receipt.voidReason
        && action.beforeSnapshot.status == 'confirmed'
        && action.beforeSnapshot.paidCents == 0
        && action.afterSnapshot.status == 'voided';
    }

    function validDraftLineUpsert(receiptId, lineId) {
      let path = purchaseReceiptPath(receiptId);
      let after = afterData(path);
      return after.status == 'draft'
        && lineId in after.lineIds
        && (
          (!exists(path) && validDraftPurchaseAction(receiptId, 'create'))
          ||
          (exists(path) && beforeData(path).status == 'draft'
            && after.draftVersion == beforeData(path).draftVersion + 1
            && validDraftPurchaseAction(receiptId, 'update_draft'))
        );
    }

    function validDraftLineDelete(receiptId, lineId) {
      let path = purchaseReceiptPath(receiptId);
      let after = afterData(path);
      return exists(path) && beforeData(path).status == 'draft'
        && after.status == 'draft' && !(lineId in after.lineIds)
        && after.draftVersion == beforeData(path).draftVersion + 1
        && validDraftPurchaseAction(receiptId, 'update_draft');
    }

    function weighingSessionPath(sessionId) {
      return /databases/$(database)/documents/weighingSessions/$(sessionId);
    }

    function weighingEntryPath(sessionId, entryId) {
      return /databases/$(database)/documents/weighingSessions/$(sessionId)/entries/$(entryId);
    }

    function weighingActionPath(sessionId, actionId) {
      return /databases/$(database)/documents/weighingSessions/$(sessionId)/actions/$(actionId);
    }

    function validFishSpecies(data) {
      return data.keys().hasOnly([
          'speciesCode', 'displayName', 'active', 'order', 'notes',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'inactiveBy', 'inactiveAt'
        ])
        && data.keys().hasAll([
          'speciesCode', 'displayName', 'active', 'order', 'notes',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'inactiveBy', 'inactiveAt'
        ])
        && data.speciesCode is string && data.speciesCode.matches('^[a-z0-9_]{1,40}$')
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.active is bool && data.order is int && data.order >= 1
        && data.notes is string && data.notes.size() <= 500
        && data.createdBy is string && data.createdAt is timestamp
        && data.updatedBy is string && data.updatedAt is timestamp
        && (data.inactiveBy == null || data.inactiveBy is string)
        && (data.inactiveAt == null || data.inactiveAt is timestamp)
        && ((data.active && data.inactiveBy == null && data.inactiveAt == null)
          || (!data.active && data.inactiveBy is string && data.inactiveAt is timestamp));
    }

    function weighingCanModify(data) {
      return data.status in ['weighing', 'completed']
        && ((data.status == 'weighing' && data.completedAt == null)
          || (data.completedAt is timestamp && now() <= data.completedAt + duration.value(7, 'd')));
    }

    function validWeighingSession(data) {
      return data.keys().hasOnly([
          'sessionCode', 'productType', 'weighingDate', 'monthKey', 'dateSortKey', 'monthSortKey', 'externalSlipNo',
          'vesselId', 'vesselCodeSnapshot', 'vesselNameSnapshot', 'status',
          'lastSequenceNo', 'fishHeadBasketCount', 'fishHeadWeightGrams',
          'fishMealBucketBasketCount', 'fishMealBucketWeightGrams',
          'fishMealBagBasketCount', 'fishMealBagWeightGrams', 'fishMealTotalWeightGrams',
          'totalWeightGrams', 'processedReceiptId', 'processedReceiptCode', 'notes',
          'revision', 'voidReason', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt',
          'completedBy', 'completedAt', 'processedBy', 'processedAt',
          'voidedBy', 'voidedAt', 'lastActionId'
        ])
        && data.keys().hasAll([
          'sessionCode', 'weighingDate', 'monthKey', 'externalSlipNo',
          'vesselId', 'vesselCodeSnapshot', 'vesselNameSnapshot', 'status',
          'lastSequenceNo', 'fishHeadBasketCount', 'fishHeadWeightGrams',
          'fishMealBucketBasketCount', 'fishMealBucketWeightGrams',
          'fishMealBagBasketCount', 'fishMealBagWeightGrams', 'fishMealTotalWeightGrams',
          'totalWeightGrams', 'processedReceiptId', 'processedReceiptCode', 'notes',
          'revision', 'voidReason', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt',
          'completedBy', 'completedAt', 'processedBy', 'processedAt',
          'voidedBy', 'voidedAt', 'lastActionId'
        ])
        && data.sessionCode is string && data.sessionCode.size() >= 5 && data.sessionCode.size() <= 80
        && (!('productType' in data) || data.productType in ['fish_head', 'fish_meal'])
        && data.weighingDate is string
        && ((data.weighingDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.monthKey == data.weighingDate[0:7])
          || (data.weighingDate.matches('^[0-9]{2}/[0-9]{2}/[0-9]{4}$') && data.monthKey == data.weighingDate[3:10]))
        && (!('dateSortKey' in data) || (data.dateSortKey is int && data.dateSortKey == int(data.weighingDate[6:10] + data.weighingDate[3:5] + data.weighingDate[0:2])))
        && (!('monthSortKey' in data) || (data.monthSortKey is int && data.monthSortKey == int(data.monthKey[3:7] + data.monthKey[0:2])))
        && data.externalSlipNo is string && data.externalSlipNo.size() <= 100
        && data.vesselId is string && data.vesselId.size() > 0
        && data.vesselCodeSnapshot is string && data.vesselCodeSnapshot.size() > 0
        && data.vesselNameSnapshot is string && data.vesselNameSnapshot.size() > 0
        && data.status in ['weighing', 'completed', 'processed', 'voided']
        && data.lastSequenceNo is int && data.lastSequenceNo >= 0
        && data.fishHeadBasketCount is int && data.fishHeadBasketCount >= 0
        && data.fishHeadWeightGrams is int && data.fishHeadWeightGrams >= 0
        && data.fishMealBucketBasketCount is int && data.fishMealBucketBasketCount >= 0
        && data.fishMealBucketWeightGrams is int && data.fishMealBucketWeightGrams >= 0
        && data.fishMealBagBasketCount is int && data.fishMealBagBasketCount >= 0
        && data.fishMealBagWeightGrams is int && data.fishMealBagWeightGrams >= 0
        && data.fishMealTotalWeightGrams == data.fishMealBucketWeightGrams + data.fishMealBagWeightGrams
        && data.totalWeightGrams == data.fishHeadWeightGrams + data.fishMealTotalWeightGrams
        && (data.processedReceiptId == null || data.processedReceiptId is string)
        && (data.processedReceiptCode == null || data.processedReceiptCode is string)
        && data.notes is string && data.notes.size() <= 500
        && data.revision is int && data.revision >= 1
        && (data.voidReason == null || (data.voidReason is string && data.voidReason.size() >= 3 && data.voidReason.size() <= 100))
        && data.createdBy is string && data.createdAt is timestamp
        && data.updatedBy is string && data.updatedAt is timestamp
        && (data.completedBy == null || data.completedBy is string)
        && (data.completedAt == null || data.completedAt is timestamp)
        && (data.processedBy == null || data.processedBy is string)
        && (data.processedAt == null || data.processedAt is timestamp)
        && (data.voidedBy == null || data.voidedBy is string)
        && (data.voidedAt == null || data.voidedAt is timestamp)
        && data.lastActionId is string && data.lastActionId.size() > 0;
    }

    function validWeighingEntry(data) {
      return data.keys().hasOnly([
          'clientEntryId', 'sessionId', 'receiptNoSnapshot', 'weighingDate', 'businessDate', 'monthKey', 'dateSortKey', 'monthSortKey', 'vesselId', 'vesselCodeSnapshot', 'productType', 'fishSpeciesId',
          'fishSpeciesCodeSnapshot', 'fishSpeciesNameSnapshot', 'fishMealQuality',
          'displayNameSnapshot', 'entryMode', 'sequenceNo', 'weightGrams', 'unitPriceCentsPerKg', 'amountCents', 'remark',
          'recordedAtClient', 'recordedAt', 'recordedBy', 'voided', 'voidReason',
          'voidedBy', 'voidedAt', 'revision', 'updatedBy', 'updatedAt', 'lastActionId'
        ])
        && data.keys().hasAll([
          'clientEntryId', 'sessionId', 'productType', 'fishSpeciesId',
          'fishSpeciesCodeSnapshot', 'fishSpeciesNameSnapshot', 'fishMealQuality',
          'displayNameSnapshot', 'entryMode', 'sequenceNo', 'weightGrams', 'remark',
          'recordedAtClient', 'recordedAt', 'recordedBy', 'voided', 'voidReason',
          'voidedBy', 'voidedAt', 'revision', 'updatedBy', 'updatedAt', 'lastActionId'
        ])
        && data.clientEntryId is string && data.clientEntryId.size() > 0
        && data.sessionId is string && data.sessionId.size() > 0
        && (!('receiptNoSnapshot' in data) || (data.receiptNoSnapshot is string && data.receiptNoSnapshot.size() >= 5 && data.receiptNoSnapshot.size() <= 80))
        && (!('weighingDate' in data) || (data.weighingDate is string
          && ((data.weighingDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.monthKey == data.weighingDate[0:7])
            || (data.weighingDate.matches('^[0-9]{2}/[0-9]{2}/[0-9]{4}$') && data.monthKey == data.weighingDate[3:10]))
          && (!('businessDate' in data) || data.businessDate == data.weighingDate)
          && (!('dateSortKey' in data) || (data.dateSortKey is int && data.dateSortKey == int(data.weighingDate[6:10] + data.weighingDate[3:5] + data.weighingDate[0:2])))
          && (!('monthSortKey' in data) || (data.monthSortKey is int && data.monthSortKey == int(data.monthKey[3:7] + data.monthKey[0:2])))
          && data.vesselId is string && data.vesselId.size() > 0
          && data.vesselCodeSnapshot is string && data.vesselCodeSnapshot.size() > 0))
        && data.productType in ['fish_head', 'fish_meal']
        && data.displayNameSnapshot is string && data.displayNameSnapshot.size() > 0
        && data.entryMode in ['individual', 'total']
        && ((data.entryMode == 'individual' && data.sequenceNo is int && data.sequenceNo >= 1
              && data.weightGrams <= 300000)
          || (data.entryMode == 'total' && data.sequenceNo == null && data.productType == 'fish_meal'
              && data.weightGrams <= 100000000))
        && data.weightGrams is int && data.weightGrams > 0
        && (!('unitPriceCentsPerKg' in data) || ((data.unitPriceCentsPerKg == null && data.amountCents == null)
          || (data.unitPriceCentsPerKg is int && data.unitPriceCentsPerKg > 0
            && data.amountCents is int && data.amountCents > 0
            && data.amountCents == int((data.weightGrams * data.unitPriceCentsPerKg + 500) / 1000))))
        && data.remark is string && data.remark.size() <= 100
        && data.recordedAtClient is string && data.recordedAtClient.size() >= 10 && data.recordedAtClient.size() <= 50
        && data.recordedAt is timestamp && data.recordedBy is string
        && data.voided is bool
        && (data.voidReason == null || (data.voidReason is string && data.voidReason.size() >= 2 && data.voidReason.size() <= 100))
        && (data.voidedBy == null || data.voidedBy is string)
        && (data.voidedAt == null || data.voidedAt is timestamp)
        && data.revision is int && data.revision >= 1
        && data.updatedBy is string && data.updatedAt is timestamp
        && data.lastActionId is string && data.lastActionId.size() > 0
        && ((data.productType == 'fish_head'
            && data.fishSpeciesId is string && data.fishSpeciesCodeSnapshot is string
            && data.fishSpeciesNameSnapshot is string && data.fishMealQuality == null)
          || (data.productType == 'fish_meal'
            && data.fishSpeciesId == null && data.fishSpeciesCodeSnapshot == null
            && data.fishSpeciesNameSnapshot == null && data.fishMealQuality in ['bucket', 'bag']));
    }

    function validWeighingSpeciesSnapshot(data) {
      return data.productType == 'fish_meal'
        || (data.fishSpeciesId.matches('^custom_[a-z0-9_]{1,35}$')
          && data.fishSpeciesCodeSnapshot == data.fishSpeciesId
          && data.fishSpeciesNameSnapshot == data.displayNameSnapshot)
        || (exists(/databases/$(database)/documents/fishSpecies/$(data.fishSpeciesId))
          && beforeData(/databases/$(database)/documents/fishSpecies/$(data.fishSpeciesId)).active == true
          && beforeData(/databases/$(database)/documents/fishSpecies/$(data.fishSpeciesId)).speciesCode == data.fishSpeciesCodeSnapshot
          && beforeData(/databases/$(database)/documents/fishSpecies/$(data.fishSpeciesId)).displayName == data.fishSpeciesNameSnapshot
          && beforeData(/databases/$(database)/documents/fishSpecies/$(data.fishSpeciesId)).displayName == data.displayNameSnapshot);
    }

    function validWeighingAction(data) {
      return data.keys().hasOnly([
          'type', 'sessionId', 'entryId', 'reason', 'performedBy', 'performedAt',
          'beforeSnapshot', 'afterSnapshot', 'clientOperationId'
        ])
        && data.keys().hasAll([
          'type', 'sessionId', 'entryId', 'reason', 'performedBy', 'performedAt',
          'beforeSnapshot', 'afterSnapshot', 'clientOperationId'
        ])
        && data.type in ['create', 'entry_create', 'entry_update', 'entry_void', 'complete', 'reopen', 'session_void', 'session_update', 'process', 'sync_conflict']
        && data.sessionId is string
        && (data.entryId == null || data.entryId is string)
        && (data.reason == null || (data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 100))
        && data.performedBy == uid() && data.performedAt == now()
        && data.clientOperationId is string && data.clientOperationId.size() > 0
        && 'afterSnapshot' in data;
    }

    function validLinkedWeighingAction(sessionId, actionType) {
      let actionId = afterData(weighingSessionPath(sessionId)).lastActionId;
      let action = afterData(weighingActionPath(sessionId, actionId));
      return existsAfter(weighingActionPath(sessionId, actionId))
        && action.type == actionType && action.sessionId == sessionId
        && action.performedBy == uid() && action.performedAt == now();
    }

    function validWeighingAggregateDelta(before, after, oldEntry, newEntry) {
      return after.fishHeadBasketCount == before.fishHeadBasketCount
          - (oldEntry.productType == 'fish_head' && oldEntry.entryMode == 'individual' ? 1 : 0)
          + (newEntry.productType == 'fish_head' && newEntry.entryMode == 'individual' ? 1 : 0)
        && after.fishHeadWeightGrams == before.fishHeadWeightGrams
          - (oldEntry.productType == 'fish_head' ? oldEntry.weightGrams : 0)
          + (newEntry.productType == 'fish_head' ? newEntry.weightGrams : 0)
        && after.fishMealBucketBasketCount == before.fishMealBucketBasketCount
          - (oldEntry.fishMealQuality == 'bucket' && oldEntry.entryMode == 'individual' ? 1 : 0)
          + (newEntry.fishMealQuality == 'bucket' && newEntry.entryMode == 'individual' ? 1 : 0)
        && after.fishMealBucketWeightGrams == before.fishMealBucketWeightGrams
          - (oldEntry.fishMealQuality == 'bucket' ? oldEntry.weightGrams : 0)
          + (newEntry.fishMealQuality == 'bucket' ? newEntry.weightGrams : 0)
        && after.fishMealBagBasketCount == before.fishMealBagBasketCount
          - (oldEntry.fishMealQuality == 'bag' && oldEntry.entryMode == 'individual' ? 1 : 0)
          + (newEntry.fishMealQuality == 'bag' && newEntry.entryMode == 'individual' ? 1 : 0)
        && after.fishMealBagWeightGrams == before.fishMealBagWeightGrams
          - (oldEntry.fishMealQuality == 'bag' ? oldEntry.weightGrams : 0)
          + (newEntry.fishMealQuality == 'bag' ? newEntry.weightGrams : 0);
    }

    function validWeighingCreateDelta(before, after, entry) {
      return after.fishHeadBasketCount == before.fishHeadBasketCount
          + (entry.productType == 'fish_head' && entry.entryMode == 'individual' ? 1 : 0)
        && after.fishHeadWeightGrams == before.fishHeadWeightGrams
          + (entry.productType == 'fish_head' ? entry.weightGrams : 0)
        && after.fishMealBucketBasketCount == before.fishMealBucketBasketCount
          + (entry.fishMealQuality == 'bucket' && entry.entryMode == 'individual' ? 1 : 0)
        && after.fishMealBucketWeightGrams == before.fishMealBucketWeightGrams
          + (entry.fishMealQuality == 'bucket' ? entry.weightGrams : 0)
        && after.fishMealBagBasketCount == before.fishMealBagBasketCount
          + (entry.fishMealQuality == 'bag' && entry.entryMode == 'individual' ? 1 : 0)
        && after.fishMealBagWeightGrams == before.fishMealBagWeightGrams
          + (entry.fishMealQuality == 'bag' ? entry.weightGrams : 0)
        && after.lastSequenceNo == (entry.entryMode == 'individual' ? entry.sequenceNo : before.lastSequenceNo);
    }

    function validWeighingIdentityUnchanged() {
      return ((existingData().status == 'weighing' && incomingData().status == 'completed' && existingData().completedAt == null)
          || (incomingData().completedAt == existingData().completedAt && incomingData().completedBy == existingData().completedBy))
        && incomingData().diff(existingData()).affectedKeys().hasOnly([
          'status', 'lastSequenceNo', 'fishHeadBasketCount', 'fishHeadWeightGrams',
          'fishMealBucketBasketCount', 'fishMealBucketWeightGrams',
          'fishMealBagBasketCount', 'fishMealBagWeightGrams', 'fishMealTotalWeightGrams',
          'totalWeightGrams', 'processedReceiptId', 'processedReceiptCode', 'revision',
          'updatedBy', 'updatedAt', 'completedBy', 'completedAt', 'processedBy',
          'processedAt', 'voidReason', 'voidedBy', 'voidedAt', 'lastActionId', 'externalSlipNo'
        ])
        && incomingData().revision == existingData().revision + 1
        && incomingData().createdBy == existingData().createdBy
        && incomingData().createdAt == existingData().createdAt
        && incomingData().updatedBy == uid()
        && incomingData().updatedAt == now();
    }

    function validWeighingControlledMetadataUpdate() {
      let before = existingData();
      let data = incomingData();
      let vessel = beforeData(/databases/$(database)/documents/vessels/$(data.vesselId));
      return data.diff(before).affectedKeys().hasOnly([
          'sessionCode', 'weighingDate', 'monthKey', 'dateSortKey', 'monthSortKey',
          'externalSlipNo', 'vesselId', 'vesselCodeSnapshot', 'vesselNameSnapshot',
          'notes', 'revision', 'updatedBy', 'updatedAt', 'lastActionId'
        ])
        && data.status == before.status && data.productType == before.productType
        && data.revision == before.revision + 1
        && data.updatedBy == uid() && data.updatedAt == now()
        && data.sessionCode is string && data.sessionCode.size() >= 5 && data.sessionCode.size() <= 80
        && data.weighingDate is string && validBusinessDate(data.weighingDate)
        && data.monthKey == data.weighingDate[3:10]
        && data.dateSortKey is int && data.dateSortKey == int(data.weighingDate[6:10] + data.weighingDate[3:5] + data.weighingDate[0:2])
        && data.monthSortKey is int && data.monthSortKey == int(data.monthKey[3:7] + data.monthKey[0:2])
        && data.externalSlipNo is string && data.externalSlipNo.size() <= 100
        && data.notes is string && data.notes.size() <= 500
        && data.vesselId is string && data.vesselId.size() > 0
        && data.vesselCodeSnapshot is string && data.vesselCodeSnapshot.size() > 0
        && data.vesselNameSnapshot is string && data.vesselNameSnapshot.size() > 0
        && vessel.active == true && vessel.vesselCode == data.vesselCodeSnapshot && vessel.displayName == data.vesselNameSnapshot;
    }

    function validWeighingMetadataAudit(sessionId) {
      let before = existingData();
      let after = incomingData();
      let action = afterData(weighingActionPath(sessionId, after.lastActionId));
      let old = action.beforeSnapshot;
      let next = action.afterSnapshot;
      return validLinkedWeighingAction(sessionId, 'session_update') && action.entryId == null
        && old.sessionCode == before.sessionCode && next.sessionCode == after.sessionCode
        && old.weighingDate == before.weighingDate && next.weighingDate == after.weighingDate
        && old.monthKey == before.monthKey && next.monthKey == after.monthKey
        && old.get('dateSortKey', null) == before.get('dateSortKey', null) && next.dateSortKey == after.dateSortKey
        && old.get('monthSortKey', null) == before.get('monthSortKey', null) && next.monthSortKey == after.monthSortKey
        && old.vesselId == before.vesselId && next.vesselId == after.vesselId
        && old.vesselCodeSnapshot == before.vesselCodeSnapshot && next.vesselCodeSnapshot == after.vesselCodeSnapshot
        && old.vesselNameSnapshot == before.vesselNameSnapshot && next.vesselNameSnapshot == after.vesselNameSnapshot
        && old.externalSlipNo == before.externalSlipNo && next.externalSlipNo == after.externalSlipNo
        && old.notes == before.notes && next.notes == after.notes;
    }

    // Only aggregate fields and the handwritten slip may change here. The linked
    // entry has its own complete schema validation in this same atomic write.
    function validWeighingEntrySessionUpdate(sessionId) {
      let before = existingData();
      let after = incomingData();
      let action = afterData(weighingActionPath(sessionId, after.lastActionId));
      let entryPath = weighingEntryPath(sessionId, action.entryId);
      let entry = afterData(entryPath);
      return after.diff(before).affectedKeys().hasOnly([
          'lastSequenceNo', 'fishHeadBasketCount', 'fishHeadWeightGrams', 'fishMealBucketBasketCount', 'fishMealBucketWeightGrams',
          'fishMealBagBasketCount', 'fishMealBagWeightGrams', 'fishMealTotalWeightGrams', 'totalWeightGrams',
          'externalSlipNo', 'revision', 'updatedBy', 'updatedAt', 'lastActionId'
        ])
        && after.revision == before.revision + 1 && after.updatedBy == uid() && after.updatedAt == now()
        && after.externalSlipNo is string && after.externalSlipNo.size() <= 100
        && after.fishMealTotalWeightGrams == after.fishMealBucketWeightGrams + after.fishMealBagWeightGrams
        && after.totalWeightGrams == after.fishHeadWeightGrams + after.fishMealTotalWeightGrams
        && action.type in ['entry_create', 'entry_update', 'entry_void']
        && action.sessionId == sessionId && action.performedBy == uid() && action.performedAt == now()
        && entry.lastActionId == after.lastActionId && entry.updatedAt == now()
        && ((action.type == 'entry_create' && !exists(entryPath) && validWeighingCreateDelta(before, after, entry))
          || (after.lastSequenceNo == before.lastSequenceNo
            && ((action.type == 'entry_update' && validWeighingAggregateDelta(before, after, beforeData(entryPath), entry))
              || (action.type == 'entry_void' && validWeighingAggregateDelta(before, after, beforeData(entryPath),
                {'productType': 'fish_meal', 'entryMode': 'total', 'weightGrams': 0, 'fishMealQuality': null})))));
    }

    function validWeighingFirstBasket(sessionId) {
      let data = incomingData();
      let action = afterData(weighingActionPath(sessionId, data.lastActionId));
      let entry = afterData(weighingEntryPath(sessionId, action.entryId));
      let vessel = beforeData(/databases/$(database)/documents/vessels/$(data.vesselId));
      return vessel.active == true && vessel.vesselCode == data.vesselCodeSnapshot && vessel.displayName == data.vesselNameSnapshot
        && validLinkedWeighingAction(sessionId, 'entry_create') && action.entryId is string
        && entry.sessionId == sessionId && entry.productType == data.productType && data.totalWeightGrams == entry.weightGrams
        && validWeighingCreateDelta({'lastSequenceNo': 0, 'fishHeadBasketCount': 0, 'fishHeadWeightGrams': 0,
          'fishMealBucketBasketCount': 0, 'fishMealBucketWeightGrams': 0, 'fishMealBagBasketCount': 0, 'fishMealBagWeightGrams': 0}, data, entry);
    }

    function validLegacyIceWorkRecord(data) {
      return data.keys().hasOnly([
          'workDate', 'monthKey', 'vesselId', 'vesselCodeSnapshot',
          'factoryWoodTubQuantity', 'iceBoxQuantity', 'hawkerSaleQuantity',
          'oilWorkQuantity', 'oilWorkRateCents', 'oilWorkAmountCents',
          'headmanFeeCents', 'clerkFeeCents', 'monthEndSettlement', 'notes', 'status',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt',
          'voided', 'voidReason', 'voidedBy', 'voidedAt'
        ])
        && data.keys().hasAll([
          'workDate', 'monthKey', 'vesselId', 'vesselCodeSnapshot',
          'factoryWoodTubQuantity', 'iceBoxQuantity', 'hawkerSaleQuantity',
          'oilWorkQuantity', 'oilWorkRateCents', 'oilWorkAmountCents',
          'headmanFeeCents', 'clerkFeeCents', 'monthEndSettlement', 'notes', 'status',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt',
          'voided', 'voidReason', 'voidedBy', 'voidedAt'
        ])
        && data.workDate is string && data.workDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.monthKey == data.workDate[0:7]
        && data.vesselId is string && data.vesselId.size() > 0
        && data.vesselCodeSnapshot is string && data.vesselCodeSnapshot.size() > 0
        && data.factoryWoodTubQuantity is number && data.factoryWoodTubQuantity >= 0
        && data.iceBoxQuantity is number && data.iceBoxQuantity >= 0
        && data.hawkerSaleQuantity is number && data.hawkerSaleQuantity >= 0
        && data.oilWorkQuantity is number && data.oilWorkQuantity >= 0
        && data.oilWorkRateCents == null && data.oilWorkAmountCents == null
          && data.headmanFeeCents is int && data.headmanFeeCents >= 0 && data.headmanFeeCents <= 1000000
          && data.clerkFeeCents is int && data.clerkFeeCents >= 0 && data.clerkFeeCents <= 1000000
          && data.monthEndSettlement is bool
          && ((data.monthEndSettlement == false && data.headmanFeeCents == 0 && data.clerkFeeCents == 0)
            || (data.monthEndSettlement == true && data.headmanFeeCents == 50000 && data.clerkFeeCents == 25000))
          && data.notes is string && data.notes.size() <= 500
        && data.status in ['recorded', 'voided'] && data.voided is bool
        && ((data.voided == false && data.status == 'recorded' && data.voidReason == null && data.voidedBy == null && data.voidedAt == null)
          || (data.voided == true && data.status == 'voided' && data.voidReason is string && data.voidReason.size() >= 2 && data.voidReason.size() <= 100 && data.voidedBy is string && data.voidedAt is timestamp))
        && data.createdBy is string && data.createdAt is timestamp && data.updatedBy is string && data.updatedAt is timestamp;
    }

    function iceWorkMonthClosingPath(vesselId, monthKey) {
      return /databases/$(database)/documents/iceWorkMonthClosings/$(vesselId + '_' + monthKey);
    }

    function validIceWorkMonthClosing(data) {
      return data.keys().hasOnly(['vesselId', 'monthKey', 'activeRecordId', 'status', 'revision', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && data.keys().hasAll(['vesselId', 'monthKey', 'activeRecordId', 'status', 'revision', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && data.vesselId is string && data.vesselId.size() > 0
        && data.monthKey is string && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.activeRecordId is string && data.activeRecordId.size() > 0
        && data.status in ['active', 'voided'] && data.revision is int && data.revision >= 1
        && data.createdBy is string && data.createdAt is timestamp && data.updatedBy is string && data.updatedAt is timestamp;
    }

    function vesselTripPath(tripId) {
      return /databases/$(database)/documents/vesselTrips/$(tripId);
    }

    function vesselTripCrewPath(tripId, crewId) {
      return /databases/$(database)/documents/vesselTrips/$(tripId)/crew/$(crewId);
    }

    function vesselTripEntryPath(entryId) {
      return /databases/$(database)/documents/vesselTripEntries/$(entryId);
    }

    function vesselCrewPaymentPath(paymentId) {
      return /databases/$(database)/documents/vesselCrewPayments/$(paymentId);
    }

    function vesselTripActionPath(tripId, actionId) {
      return /databases/$(database)/documents/vesselTrips/$(tripId)/actions/$(actionId);
    }

    function validDraftVesselTripUpdate(tripId) {
      let action = afterData(vesselTripActionPath(tripId, incomingData().lastActionId));
      let crew = action.type == 'crew_add'
        ? afterData(vesselTripCrewPath(tripId, action.crewSettlementId))
        : {};
      let entry = action.type in ['entry_add', 'entry_void']
        ? afterData(vesselTripEntryPath(action.entryId))
        : {};
      return incomingData().diff(existingData()).affectedKeys().hasOnly([
          'incomeCents', 'expenseCents', 'crewWageCents', 'crewAdvanceCents',
          'profitCents', 'revision', 'updatedBy', 'updatedAt', 'lastActionId'
        ])
        && (
          (action.type == 'crew_add'
            && existsAfter(vesselTripCrewPath(tripId, action.crewSettlementId))
            && crew.lastActionId == incomingData().lastActionId
            && incomingData().crewWageCents == existingData().crewWageCents + crew.grossWageCents
            && incomingData().crewAdvanceCents == existingData().crewAdvanceCents + crew.advanceCents)
          ||
          (action.type == 'entry_add'
            && existsAfter(vesselTripEntryPath(action.entryId))
            && entry.lastActionId == incomingData().lastActionId
            && ((entry.type == 'income'
                && incomingData().incomeCents == existingData().incomeCents + entry.amountCents
                && incomingData().expenseCents == existingData().expenseCents)
              || (entry.type == 'expense'
                && incomingData().expenseCents == existingData().expenseCents + entry.amountCents
                && incomingData().incomeCents == existingData().incomeCents)))
          ||
          (action.type == 'entry_void'
            && existsAfter(vesselTripEntryPath(action.entryId))
            && entry.voided == true && entry.lastActionId == incomingData().lastActionId
            && ((entry.type == 'income'
                && incomingData().incomeCents == existingData().incomeCents - entry.amountCents
                && incomingData().expenseCents == existingData().expenseCents)
              || (entry.type == 'expense'
                && incomingData().expenseCents == existingData().expenseCents - entry.amountCents
                && incomingData().incomeCents == existingData().incomeCents)))
        );
    }

    function validVesselTripPaymentUpdate(tripId) {
      let action = afterData(vesselTripActionPath(tripId, incomingData().lastActionId));
      let payment = afterData(vesselCrewPaymentPath(action.paymentId));
      return action.paymentId is string
        && existsAfter(vesselCrewPaymentPath(action.paymentId))
        && payment.tripId == tripId
        && payment.lastActionId == incomingData().lastActionId
        && incomingData().diff(existingData()).affectedKeys().hasOnly([
          'crewAdvanceCents', 'crewPaidCents', 'revision', 'updatedBy', 'updatedAt', 'lastActionId'
        ])
        && (
          (action.type == 'payment_create' && payment.voided == false
            && payment.createdAt == now()
            && ((payment.paymentType == 'advance'
                && incomingData().crewAdvanceCents == existingData().crewAdvanceCents + payment.amountCents
                && incomingData().crewPaidCents == existingData().crewPaidCents)
              || (payment.paymentType == 'settlement'
                && incomingData().crewPaidCents == existingData().crewPaidCents + payment.amountCents
                && incomingData().crewAdvanceCents == existingData().crewAdvanceCents)))
          ||
          (action.type == 'payment_void' && payment.voided == true
            && payment.voidedAt == now()
            && ((payment.paymentType == 'advance'
                && incomingData().crewAdvanceCents == existingData().crewAdvanceCents - payment.amountCents
                && incomingData().crewPaidCents == existingData().crewPaidCents)
              || (payment.paymentType == 'settlement'
                && incomingData().crewPaidCents == existingData().crewPaidCents - payment.amountCents
                && incomingData().crewAdvanceCents == existingData().crewAdvanceCents)))
        );
    }

    function validVesselCrewPaymentUpdate(tripId) {
      let actionId = afterData(vesselTripPath(tripId)).lastActionId;
      let action = afterData(vesselTripActionPath(tripId, actionId));
      let payment = afterData(vesselCrewPaymentPath(action.paymentId));
      return action.paymentId is string
        && existsAfter(vesselCrewPaymentPath(action.paymentId))
        && payment.tripId == tripId
        && payment.crewSettlementId == existingData().id
        && incomingData().lastActionId == actionId
        && incomingData().diff(existingData()).affectedKeys().hasOnly([
          'advanceCents', 'paidCents', 'balanceCents', 'lastActionId'
        ])
        && (
          (action.type == 'payment_create' && payment.createdAt == now()
            && ((payment.paymentType == 'advance'
                && incomingData().advanceCents == existingData().advanceCents + payment.amountCents
                && incomingData().paidCents == existingData().paidCents)
              || (payment.paymentType == 'settlement'
                && incomingData().paidCents == existingData().paidCents + payment.amountCents
                && incomingData().advanceCents == existingData().advanceCents)))
          ||
          (action.type == 'payment_void' && payment.voidedAt == now()
            && ((payment.paymentType == 'advance'
                && incomingData().advanceCents == existingData().advanceCents - payment.amountCents
                && incomingData().paidCents == existingData().paidCents)
              || (payment.paymentType == 'settlement'
                && incomingData().paidCents == existingData().paidCents - payment.amountCents
                && incomingData().advanceCents == existingData().advanceCents)))
        );
    }

    function validVesselWageTemplate(data) {
      return data.keys().hasOnly([
          'id', 'vesselId', 'vesselCode', 'name', 'dayRateCents', 'nightRateCents',
          'captainDayRateCents', 'captainNightRateCents', 'crewDayRateCents',
          'crewNightRateCents', 'crewHeadcount', 'active',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
        ])
        && data.keys().hasAll([
          'id', 'vesselId', 'vesselCode', 'name', 'dayRateCents', 'nightRateCents',
          'captainDayRateCents', 'captainNightRateCents', 'crewDayRateCents',
          'crewNightRateCents', 'crewHeadcount', 'active',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
        ])
        && data.id is string && data.vesselId is string
        && data.vesselCode is string && data.vesselCode.size() >= 1 && data.vesselCode.size() <= 30
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.dayRateCents is int && data.dayRateCents >= 0
        && data.nightRateCents is int && data.nightRateCents >= 0
        && data.captainDayRateCents is int && data.captainDayRateCents >= 0
        && data.captainNightRateCents is int && data.captainNightRateCents >= 0
        && data.crewDayRateCents is int && data.crewDayRateCents >= 0
        && data.crewNightRateCents is int && data.crewNightRateCents >= 0
        && data.crewHeadcount is int && data.crewHeadcount >= 1 && data.crewHeadcount <= 20
        && data.dayRateCents == data.captainDayRateCents + data.crewDayRateCents * data.crewHeadcount
        && data.nightRateCents == data.captainNightRateCents + data.crewNightRateCents * data.crewHeadcount
        && data.active is bool
        && data.createdBy is string && data.createdAt is timestamp
        && data.updatedBy is string && data.updatedAt is timestamp;
    }

    function validVesselTrip(data) {
      return data.keys().hasOnly([
          'id', 'tripCode', 'vesselId', 'vesselCodeSnapshot', 'vesselNameSnapshot',
          'departureDate', 'returnDate', 'status', 'incomeCents', 'expenseCents',
          'crewWageCents', 'crewAdvanceCents', 'crewPaidCents', 'profitCents',
          'notes', 'revision', 'voidReason', 'createdBy', 'createdAt', 'updatedBy',
          'updatedAt', 'lastActionId', 'confirmedBy', 'confirmedAt', 'settledBy', 'settledAt',
          'voidedBy', 'voidedAt'
        ])
        && data.keys().hasAll([
          'id', 'tripCode', 'vesselId', 'vesselCodeSnapshot', 'vesselNameSnapshot',
          'departureDate', 'returnDate', 'status', 'incomeCents', 'expenseCents',
          'crewWageCents', 'crewAdvanceCents', 'crewPaidCents', 'profitCents',
          'notes', 'revision', 'voidReason', 'createdBy', 'createdAt', 'updatedBy',
          'updatedAt', 'lastActionId'
        ])
        && data.id is string && data.tripCode is string && data.tripCode.size() >= 1 && data.tripCode.size() <= 50
        && data.vesselId is string && data.vesselId.size() > 0
        && data.vesselCodeSnapshot is string && data.vesselNameSnapshot is string
        && data.departureDate is string && data.departureDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.returnDate is string && data.returnDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.returnDate >= data.departureDate
        && data.status in ['draft', 'confirmed', 'settled', 'voided']
        && data.incomeCents is int && data.incomeCents >= 0
        && data.expenseCents is int && data.expenseCents >= 0
        && data.crewWageCents is int && data.crewWageCents >= 0
        && data.crewAdvanceCents is int && data.crewAdvanceCents >= 0
        && data.crewPaidCents is int && data.crewPaidCents >= 0
        && data.crewAdvanceCents + data.crewPaidCents <= data.crewWageCents
        && data.profitCents == data.incomeCents - data.expenseCents - data.crewWageCents
        && data.notes is string && data.notes.size() <= 500
        && data.revision is int && data.revision >= 1
        && (data.voidReason == null || (data.voidReason is string && data.voidReason.size() >= 3 && data.voidReason.size() <= 100))
        && data.createdBy is string && data.createdAt is timestamp
        && data.updatedBy is string && data.updatedAt is timestamp
        && data.lastActionId is string && data.lastActionId.size() > 0
        && (!('confirmedBy' in data) || data.confirmedBy is string)
        && (!('confirmedAt' in data) || data.confirmedAt is timestamp)
        && (!('settledBy' in data) || data.settledBy is string)
        && (!('settledAt' in data) || data.settledAt is timestamp)
        && (!('voidedBy' in data) || data.voidedBy is string)
        && (!('voidedAt' in data) || data.voidedAt is timestamp);
    }

    function validVesselCrewSettlement(data) {
      return data.keys().hasOnly([
          'id', 'tripId', 'workerId', 'workerNameSnapshot', 'role', 'templateId',
          'halfDayUnits', 'nightCount', 'dayRateCents', 'nightRateCents', 'grossWageCents',
          'advanceCents', 'paidCents', 'balanceCents', 'createdBy', 'createdAt', 'lastActionId'
        ])
        && data.keys().hasAll([
          'id', 'tripId', 'workerId', 'workerNameSnapshot', 'role', 'templateId',
          'halfDayUnits', 'nightCount', 'dayRateCents', 'nightRateCents', 'grossWageCents',
          'advanceCents', 'paidCents', 'balanceCents', 'createdBy', 'createdAt', 'lastActionId'
        ])
        && data.id is string && data.tripId is string
        && data.workerId is string && data.workerId.size() > 0
        && data.workerNameSnapshot is string && data.workerNameSnapshot.size() > 0
        && data.role in ['captain', 'crew'] && data.templateId is string
        && data.halfDayUnits is int && data.halfDayUnits >= 1 && data.halfDayUnits <= 730
        && data.nightCount is int && data.nightCount >= 0 && data.nightCount <= 365
        && data.dayRateCents is int && data.dayRateCents >= 0
        && data.nightRateCents is int && data.nightRateCents >= 0
        && data.grossWageCents is int
        && data.grossWageCents == int(data.halfDayUnits * data.dayRateCents / 2) + data.nightCount * data.nightRateCents
        && data.advanceCents is int && data.advanceCents >= 0
        && data.paidCents is int && data.paidCents >= 0
        && data.balanceCents == data.grossWageCents - data.advanceCents - data.paidCents
        && data.balanceCents is int && data.balanceCents >= 0
        && data.createdBy is string && data.createdAt is timestamp
        && data.lastActionId is string && data.lastActionId.size() > 0;
    }

    function validVesselTripEntry(data) {
      return data.keys().hasOnly([
          'tripId', 'type', 'category', 'amountCents', 'date', 'note',
          'voided', 'voidReason', 'createdBy', 'createdAt', 'lastActionId'
        ])
        && data.keys().hasAll([
          'tripId', 'type', 'category', 'amountCents', 'date', 'note',
          'voided', 'voidReason', 'createdBy', 'createdAt', 'lastActionId'
        ])
        && data.tripId is string && data.type in ['income', 'expense']
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.amountCents is int && data.amountCents > 0
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.note is string && data.note.size() <= 500
        && data.voided is bool
        && ((data.voided == false && data.voidReason == null)
          || (data.voided == true && data.voidReason is string
            && data.voidReason.size() >= 3 && data.voidReason.size() <= 100))
        && data.createdBy is string && data.createdAt is timestamp
        && data.lastActionId is string;
    }

    function validVesselCrewPayment(data) {
      return data.keys().hasOnly([
          'tripId', 'crewSettlementId', 'workerId', 'workerNameSnapshot', 'amountCents',
          'paymentType', 'method', 'paymentDate', 'reference', 'note', 'voided', 'voidReason',
          'createdBy', 'createdAt', 'voidedBy', 'voidedAt', 'lastActionId'
        ])
        && data.keys().hasAll([
          'tripId', 'crewSettlementId', 'workerId', 'workerNameSnapshot', 'amountCents',
          'paymentType', 'method', 'paymentDate', 'reference', 'note', 'voided', 'voidReason',
          'createdBy', 'createdAt', 'voidedBy', 'voidedAt', 'lastActionId'
        ])
        && data.tripId is string && data.crewSettlementId is string
        && data.workerId is string && data.workerNameSnapshot is string
        && data.paymentType in ['advance', 'settlement']
        && data.amountCents is int && data.amountCents > 0
        && data.method in ['cash', 'bank', 'other']
        && data.paymentDate is string && data.paymentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.reference is string && data.reference.size() <= 100
        && data.note is string && data.note.size() <= 500
        && data.voided is bool
        && (data.voidReason == null || (data.voidReason is string && data.voidReason.size() >= 3 && data.voidReason.size() <= 100))
        && data.createdBy is string && data.createdAt is timestamp
        && (data.voidedBy == null || data.voidedBy is string)
        && (data.voidedAt == null || data.voidedAt is timestamp)
        && data.lastActionId is string;
    }

    function validWageDateKey(dateKey) {
      return dateKey is string
        && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        // timestamp.date rejects impossible calendar dates, including non-leap 29 February.
        && timestamp.date(int(dateKey[0:4]), int(dateKey[5:7]), int(dateKey[8:10]))
          == timestamp.date(int(dateKey[0:4]), int(dateKey[5:7]), int(dateKey[8:10]));
    }

    function validWageEntry(data) {
      return data.keys().hasOnly([
          'dateKey', 'businessDate', 'dateSortKey', 'monthKey', 'monthSortKey', 'workerId', 'workerName', 'weightKg', 'rateRm',
          'wageRm', 'createdBy', 'createdAt', 'updatedAt', 'deleted'
        ])
        && data.keys().hasAll([
          'dateKey', 'workerId', 'workerName', 'weightKg', 'rateRm',
          'wageRm', 'createdBy', 'createdAt', 'updatedAt', 'deleted'
        ])
        && validWageDateKey(data.dateKey)
        && ((data.keys().hasAll(['businessDate', 'dateSortKey', 'monthKey', 'monthSortKey'])
          && data.businessDate is string && data.businessDate == data.dateKey[8:10] + '/' + data.dateKey[5:7] + '/' + data.dateKey[0:4]
          && data.dateSortKey is int && data.dateSortKey == int(data.dateKey[0:4] + data.dateKey[5:7] + data.dateKey[8:10])
          && data.monthKey is string && data.monthKey == data.businessDate[3:10]
          && data.monthSortKey is int && data.monthSortKey == int(data.monthKey[3:7] + data.monthKey[0:2]))
          || (!('businessDate' in data) && !('dateSortKey' in data) && !('monthKey' in data) && !('monthSortKey' in data)))
        && data.workerId is string && data.workerId.size() > 0
        && data.workerName is string && data.workerName.size() > 0
        && data.weightKg is int && data.weightKg >= 1 && data.weightKg <= 300
        && data.rateRm is string && data.rateRm.matches('^[0-9][.][0-9]{2}$') && data.rateRm != '0.00'
        && data.wageRm is string && data.wageRm.matches('^[0-9]+[.][0-9]{2}$')
        && data.createdBy is string && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.deleted is bool;
    }

    function validMonth(data) {
      return data.keys().hasOnly([
          'monthKey', 'status', 'closeVersion', 'workerCount', 'basketCount',
          'totalWeightKg', 'totalWageCents', 'paidCents', 'closedBy', 'closedAt',
          'reopenedBy', 'reopenedAt', 'updatedAt', 'lastActionId',
          'closingToken', 'closingBy', 'closingAt', 'statementIds'
        ])
        && data.keys().hasAll([
          'monthKey', 'status', 'closeVersion', 'workerCount', 'basketCount',
          'totalWeightKg', 'totalWageCents', 'paidCents', 'closedBy', 'closedAt',
          'reopenedBy', 'reopenedAt', 'updatedAt', 'lastActionId',
          'closingToken', 'closingBy', 'closingAt', 'statementIds'
        ])
        && data.monthKey is string && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.status in ['open', 'closed']
        && data.closeVersion is int && data.closeVersion >= 0
        && data.workerCount is int && data.workerCount >= 0
        && data.basketCount is int && data.basketCount >= 0
        && data.totalWeightKg is int && data.totalWeightKg >= 0
        && data.totalWageCents is int && data.totalWageCents >= 0
        && data.paidCents is int && data.paidCents >= 0 && data.paidCents <= data.totalWageCents
        && (data.closedBy == null || (data.closedBy is string && data.closedBy.size() > 0))
        && (data.closedAt == null || data.closedAt is timestamp)
        && (data.reopenedBy == null || data.reopenedBy is string)
        && (data.reopenedAt == null || data.reopenedAt is timestamp)
        && data.updatedAt is timestamp
        && data.lastActionId is string && data.lastActionId.size() > 0
        && (data.closingToken == null || (data.closingToken is string && data.closingToken.size() > 0))
        && (data.closingBy == null || (data.closingBy is string && data.closingBy.size() > 0))
        && (data.closingAt == null || data.closingAt is timestamp)
        && data.statementIds is list
        && (
          (data.status == 'open'
            && data.closingToken == null && data.closingBy == null && data.closingAt == null)
          ||
          (data.status == 'open'
            && data.closingToken is string && data.closingBy is string && data.closingAt is timestamp)
          ||
          (data.status == 'closed'
            && data.closeVersion >= 1 && data.workerCount >= 1 && data.basketCount >= 1
            && data.totalWeightKg >= 1 && data.totalWageCents >= 1
            && data.closedBy is string && data.closedAt is timestamp
            && data.closingToken == null && data.closingBy == null && data.closingAt == null
            && data.statementIds.size() == data.workerCount)
        );
    }

    function validRateBreakdown(data) {
      return data is map
        && data.keys().hasOnly(['rate12Cents', 'rate15Cents', 'rate18Cents', 'customCents'])
        && data.keys().hasAll(['rate12Cents', 'rate15Cents', 'rate18Cents', 'customCents'])
        && data.rate12Cents is int && data.rate12Cents >= 0
        && data.rate15Cents is int && data.rate15Cents >= 0
        && data.rate18Cents is int && data.rate18Cents >= 0
        && data.customCents is int && data.customCents >= 0;
    }

    function validStatement(data) {
      return data.keys().hasOnly([
          'id', 'monthKey', 'closeVersion', 'workerId', 'workerName',
          'basketCount', 'totalWeightKg', 'wageCents', 'paidCents',
          'rateBreakdown', 'snapshotAt', 'createdBy', 'lastActionId'
        ])
        && data.keys().hasAll([
          'id', 'monthKey', 'closeVersion', 'workerId', 'workerName',
          'basketCount', 'totalWeightKg', 'wageCents', 'paidCents',
          'rateBreakdown', 'snapshotAt', 'createdBy', 'lastActionId'
        ])
        && data.id is string && data.id.size() > 0
        && data.monthKey is string && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.closeVersion is int && data.closeVersion >= 1
        && data.workerId is string && data.workerId.size() > 0
        && data.workerName is string && data.workerName.size() > 0 && data.workerName.size() <= 100
        && data.basketCount is int && data.basketCount >= 1
        && data.totalWeightKg is int && data.totalWeightKg >= 1
        && data.wageCents is int && data.wageCents >= 1
        && data.paidCents is int && data.paidCents >= 0 && data.paidCents <= data.wageCents
        && validRateBreakdown(data.rateBreakdown)
        && data.rateBreakdown.rate12Cents + data.rateBreakdown.rate15Cents
          + data.rateBreakdown.rate18Cents + data.rateBreakdown.customCents == data.wageCents
        && data.snapshotAt is timestamp
        && data.createdBy is string && data.createdBy.size() > 0
        && data.lastActionId is string && data.lastActionId.size() > 0;
    }

    function validPayment(data) {
      return data.keys().hasOnly([
          'monthKey', 'closeVersion', 'workerId', 'workerName', 'statementId',
          'amountCents', 'method', 'paymentDate', 'reference', 'note',
          'createdBy', 'createdAt', 'voided', 'voidReason', 'voidedBy', 'voidedAt'
        ])
        && data.keys().hasAll([
          'monthKey', 'closeVersion', 'workerId', 'workerName', 'statementId',
          'amountCents', 'method', 'paymentDate', 'reference', 'note',
          'createdBy', 'createdAt', 'voided', 'voidReason', 'voidedBy', 'voidedAt'
        ])
        && data.monthKey is string && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.closeVersion is int && data.closeVersion >= 1
        && data.workerId is string && data.workerId.size() > 0
        && data.workerName is string && data.workerName.size() > 0 && data.workerName.size() <= 100
        && data.statementId is string && data.statementId.size() > 0
        && data.amountCents is int && data.amountCents > 0
        && data.method in ['cash', 'bank', 'other']
        && data.paymentDate is string && data.paymentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.reference is string && data.reference.size() <= 100
        && data.note is string && data.note.size() <= 500
        && data.createdBy is string && data.createdAt is timestamp
        && data.voided is bool
        && (data.voidReason == null || data.voidReason is string)
        && (data.voidedBy == null || data.voidedBy is string)
        && (data.voidedAt == null || data.voidedAt is timestamp);
    }

    function validAction(data) {
      return data.keys().hasOnly([
          'type', 'monthKey', 'closeVersion', 'workerId', 'paymentId', 'reason',
          'performedBy', 'performedAt', 'beforeSnapshot', 'afterSnapshot'
        ])
        && data.keys().hasAll(['type', 'monthKey', 'closeVersion', 'performedBy', 'performedAt'])
        && data.type in ['close', 'reopen', 'payment_create', 'payment_void']
        && data.monthKey is string && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.closeVersion is int && data.closeVersion >= 1
        && data.performedBy == uid()
        && data.performedAt == now()
        && (!('workerId' in data) || data.workerId is string)
        && (!('paymentId' in data) || data.paymentId is string)
        && (!('reason' in data) || (data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 100))
        && (
          (data.type == 'close' && 'afterSnapshot' in data)
          || (data.type == 'reopen' && 'reason' in data && 'beforeSnapshot' in data && 'afterSnapshot' in data)
          || (data.type == 'payment_create' && 'workerId' in data && 'paymentId' in data && 'afterSnapshot' in data)
          || (data.type == 'payment_void' && 'workerId' in data && 'paymentId' in data
            && 'reason' in data && 'beforeSnapshot' in data && 'afterSnapshot' in data)
        );
    }

    function validCloseAction(monthKey, version, actionId) {
      let month = afterData(monthPath(monthKey));
      let action = afterData(actionPath(monthKey, actionId));
      return actionId == 'close_' + string(version)
        && existsAfter(actionPath(monthKey, actionId))
        && action.type == 'close'
        && action.monthKey == monthKey
        && action.closeVersion == version
        && action.afterSnapshot.monthKey == month.monthKey
        && action.afterSnapshot.status == month.status
        && action.afterSnapshot.closeVersion == month.closeVersion
        && action.afterSnapshot.workerCount == month.workerCount
        && action.afterSnapshot.basketCount == month.basketCount
        && action.afterSnapshot.totalWeightKg == month.totalWeightKg
        && action.afterSnapshot.totalWageCents == month.totalWageCents
        && action.afterSnapshot.paidCents == month.paidCents
        && action.afterSnapshot.statementIds == month.statementIds;
    }

    function validPaymentMonthUpdate(monthKey) {
      let action = afterData(actionPath(monthKey, incomingData().lastActionId));
      let payment = afterData(paymentPath(monthKey, action.paymentId));
      return existingData().status == 'closed'
        && incomingData().status == 'closed'
        && incomingData().diff(existingData()).affectedKeys().hasOnly(['paidCents', 'updatedAt', 'lastActionId'])
        && incomingData().updatedAt == now()
        && existsAfter(actionPath(monthKey, incomingData().lastActionId))
        && existsAfter(paymentPath(monthKey, action.paymentId))
        && action.monthKey == monthKey
        && action.closeVersion == existingData().closeVersion
        && payment.closeVersion == existingData().closeVersion
        && (
          (action.type == 'payment_create'
            && incomingData().lastActionId == 'payment_create_' + action.paymentId
            && payment.voided == false
            && payment.createdAt == now()
            && incomingData().paidCents == existingData().paidCents + payment.amountCents)
          ||
          (action.type == 'payment_void'
            && incomingData().lastActionId == 'payment_void_' + action.paymentId
            && payment.voided == true
            && payment.voidedAt == now()
            && incomingData().paidCents == existingData().paidCents - payment.amountCents)
        );
    }

    match /workers/{workerId} {
      allow read: if signedIn();
      allow create: if signedIn() && validWorker(incomingData())
        && incomingData().keys().hasAll([
          'workerCode', 'phone', 'department', 'employmentStartDate', 'employmentEndDate',
          'notes', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'inactiveBy', 'inactiveAt'
        ])
        && incomingData().active == true
        && incomingData().createdBy == uid()
        && incomingData().createdAt == now()
        && incomingData().updatedBy == uid()
        && incomingData().updatedAt == now()
        && incomingData().inactiveBy == null
        && incomingData().inactiveAt == null;
      allow update: if signedIn() && validWorker(incomingData())
        && (!('workerCode' in existingData()) || incomingData().workerCode == existingData().workerCode)
        && (('createdBy' in existingData() && incomingData().createdBy == existingData().createdBy)
          || (!('createdBy' in existingData()) && !('createdBy' in incomingData())))
        && (('createdAt' in existingData() && incomingData().createdAt == existingData().createdAt)
          || (!('createdAt' in existingData()) && !('createdAt' in incomingData())))
        && incomingData().updatedBy == uid()
        && incomingData().updatedAt == now()
        && (
          (incomingData().active == existingData().active
            && ((!('inactiveBy' in existingData()) && incomingData().inactiveBy == null)
              || incomingData().inactiveBy == existingData().inactiveBy)
            && ((!('inactiveAt' in existingData()) && incomingData().inactiveAt == null)
              || incomingData().inactiveAt == existingData().inactiveAt))
          || (existingData().active == true && incomingData().active == false
            && incomingData().inactiveBy == uid()
            && incomingData().inactiveAt == now())
          || (existingData().active == false && incomingData().active == true
            && incomingData().inactiveBy == null && incomingData().inactiveAt == null)
        );
      allow delete: if false;
    }

    match /businessPartners/{partnerId} {
      allow read: if signedIn();
      allow create: if signedIn() && validPartner(incomingData())
        && incomingData().active == true
        && incomingData().createdBy == uid()
        && incomingData().createdAt == now()
        && incomingData().updatedBy == uid()
        && incomingData().updatedAt == now()
        && incomingData().inactiveBy == null
        && incomingData().inactiveAt == null;
      allow update: if signedIn() && validPartner(incomingData())
        && incomingData().partnerCode == existingData().partnerCode
        && incomingData().createdBy == existingData().createdBy
        && incomingData().createdAt == existingData().createdAt
        && incomingData().updatedBy == uid()
        && incomingData().updatedAt == now()
        && (
          (incomingData().active == existingData().active
