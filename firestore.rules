            && request.resource.data.lastActionId == 'confirm')
          ||
          (resource.data.status in ['draft', 'confirmed']
            && request.resource.data.status == resource.data.status
            && validVesselTripPaymentUpdate(tripId))
          ||
          (resource.data.status == 'confirmed' && request.resource.data.status == 'settled'
            && request.resource.data.crewAdvanceCents + request.resource.data.crewPaidCents
              == request.resource.data.crewWageCents
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'revision', 'settledBy', 'settledAt', 'updatedBy', 'updatedAt', 'lastActionId'
            ])
            && request.resource.data.settledBy == request.auth.uid
            && request.resource.data.settledAt == request.time
            && request.resource.data.lastActionId == 'settle')
          ||
