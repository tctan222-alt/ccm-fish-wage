            && request.resource.data.status == 'voided'
            && resource.data.crewAdvanceCents == 0 && request.resource.data.crewAdvanceCents == 0
            && resource.data.crewPaidCents == 0 && request.resource.data.crewPaidCents == 0
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'voidReason', 'revision', 'voidedBy', 'voidedAt', 'updatedBy', 'updatedAt', 'lastActionId'
            ])
            && request.resource.data.voidedBy == request.auth.uid
            && request.resource.data.voidedAt == request.time
            && request.resource.data.lastActionId == 'void'
            && getAfter(/databases/$(database)/documents/vesselTrips/$(tripId)/actions/void).data.reason
