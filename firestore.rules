        && getAfter(vesselTripActionPath(resource.data.tripId, request.resource.data.lastActionId)).data.afterSnapshot.incomeCents
          == getAfter(vesselTripPath(resource.data.tripId)).data.incomeCents
        && getAfter(vesselTripActionPath(resource.data.tripId, request.resource.data.lastActionId)).data.afterSnapshot.expenseCents
