      allow read: if signedIn();
      allow create: if signedIn() && validPurchasePayment(incomingData())
        && incomingData().createdBy == uid() && incomingData().createdAt == now()
        && incomingData().voided == false && incomingData().voidReason == null
        && incomingData().voidedBy == null && incomingData().voidedAt == null
        && beforeData(purchaseReceiptPath(incomingData().receiptId)).status == 'confirmed'
        && incomingData().receiptCode == beforeData(purchaseReceiptPath(incomingData().receiptId)).receiptCode
        && incomingData().supplierId == beforeData(purchaseReceiptPath(incomingData().receiptId)).supplierId
        && incomingData().supplierNameSnapshot == beforeData(purchaseReceiptPath(incomingData().receiptId)).supplierNameSnapshot
        && incomingData().amountCents
          <= beforeData(purchaseReceiptPath(incomingData().receiptId)).totalAmountCents
            - beforeData(purchaseReceiptPath(incomingData().receiptId)).paidCents
        && afterData(purchaseReceiptPath(incomingData().receiptId)).paidCents
          == beforeData(purchaseReceiptPath(incomingData().receiptId)).paidCents + incomingData().amountCents
        && validLinkedPurchaseAction(incomingData().receiptId, 'payment_create')
        && afterData(purchaseActionPath(
          incomingData().receiptId,
          afterData(purchaseReceiptPath(incomingData().receiptId)).lastActionId
        )).paymentId == paymentId;
      allow update: if signedIn() && validPurchasePayment(incomingData())
        && existingData().voided == false && incomingData().voided == true
        && incomingData().diff(existingData()).affectedKeys().hasOnly([
          'voided', 'voidReason', 'voidedBy', 'voidedAt'
        ])
        && incomingData().voidedBy == uid() && incomingData().voidedAt == now()
        && afterData(purchaseReceiptPath(existingData().receiptId)).paidCents
          == beforeData(purchaseReceiptPath(existingData().receiptId)).paidCents - existingData().amountCents
        && afterData(purchaseReceiptPath(existingData().receiptId)).paidCents >= 0
        && validLinkedPurchaseAction(existingData().receiptId, 'payment_void')
        && afterData(purchaseActionPath(
          existingData().receiptId,
          afterData(purchaseReceiptPath(existingData().receiptId)).lastActionId
        )).paymentId == paymentId
        && afterData(purchaseActionPath(
          existingData().receiptId,
          afterData(purchaseReceiptPath(existingData().receiptId)).lastActionId
        )).reason == incomingData().voidReason;
      allow delete: if false;
    }

    match /vesselWageTemplates/{templateId} {
      allow read: if signedIn();
      allow create: if signedIn() && validVesselWageTemplate(incomingData())
        && incomingData().id == templateId
        && incomingData().createdBy == uid()
        && incomingData().createdAt == now()
        && incomingData().updatedBy == uid()
        && incomingData().updatedAt == now();
      allow update: if signedIn() && validVesselWageTemplate(incomingData())
        && incomingData().id == existingData().id
        && incomingData().createdBy == existingData().createdBy
        && incomingData().createdAt == existingData().createdAt
        && incomingData().updatedBy == uid()
        && incomingData().updatedAt == now();
      allow delete: if false;
    }

    match /vesselTrips/{tripId} {
      allow read: if signedIn();
      allow create: if signedIn() && validVesselTrip(incomingData())
        && incomingData().id == tripId
        && incomingData().status == 'draft'
        && incomingData().incomeCents == 0 && incomingData().expenseCents == 0
        && incomingData().crewWageCents == 0 && incomingData().crewAdvanceCents == 0
        && incomingData().crewPaidCents == 0 && incomingData().profitCents == 0
        && incomingData().revision == 1 && incomingData().voidReason == null
        && incomingData().createdBy == uid() && incomingData().createdAt == now()
        && incomingData().updatedBy == uid() && incomingData().updatedAt == now()
        && incomingData().lastActionId == 'create'
        && beforeData(/databases/$(database)/documents/vessels/$(incomingData().vesselId)).active == true
        && beforeData(/databases/$(database)/documents/vessels/$(incomingData().vesselId)).vesselCode
          == incomingData().vesselCodeSnapshot
        && beforeData(/databases/$(database)/documents/vessels/$(incomingData().vesselId)).displayName
          == incomingData().vesselNameSnapshot;
      allow update: if signedIn() && validVesselTrip(incomingData())
        && incomingData().id == existingData().id
        && incomingData().createdBy == existingData().createdBy
        && incomingData().createdAt == existingData().createdAt
        && incomingData().vesselId == existingData().vesselId
        && incomingData().vesselCodeSnapshot == existingData().vesselCodeSnapshot
        && incomingData().vesselNameSnapshot == existingData().vesselNameSnapshot
        && incomingData().tripCode == existingData().tripCode
        && incomingData().departureDate == existingData().departureDate
        && incomingData().returnDate == existingData().returnDate
        && incomingData().notes == existingData().notes
        && incomingData().revision == existingData().revision + 1
        && incomingData().updatedBy == uid() && incomingData().updatedAt == now()
        && existsAfter(/databases/$(database)/documents/vesselTrips/$(tripId)/actions/$(incomingData().lastActionId))
        && afterData(/databases/$(database)/documents/vesselTrips/$(tripId)/actions/$(incomingData().lastActionId)).performedBy
          == uid()
        && afterData(/databases/$(database)/documents/vesselTrips/$(tripId)/actions/$(incomingData().lastActionId)).performedAt
          == now()
        && (
          (existingData().status == 'draft' && incomingData().status == 'draft'
            && validDraftVesselTripUpdate(tripId))
          ||
          (existingData().status == 'draft' && incomingData().status == 'confirmed'
            && incomingData().diff(existingData()).affectedKeys().hasOnly([
              'status', 'revision', 'confirmedBy', 'confirmedAt', 'updatedBy', 'updatedAt', 'lastActionId'
            ])
            && incomingData().confirmedBy == uid()
            && incomingData().confirmedAt == now()
            && incomingData().lastActionId == 'confirm')
          ||
          (existingData().status in ['draft', 'confirmed']
            && incomingData().status == existingData().status
            && validVesselTripPaymentUpdate(tripId))
          ||
          (existingData().status == 'confirmed' && incomingData().status == 'settled'
            && incomingData().crewAdvanceCents + incomingData().crewPaidCents
              == incomingData().crewWageCents
            && incomingData().diff(existingData()).affectedKeys().hasOnly([
              'status', 'revision', 'settledBy', 'settledAt', 'updatedBy', 'updatedAt', 'lastActionId'
            ])
            && incomingData().settledBy == uid()
            && incomingData().settledAt == now()
            && incomingData().lastActionId == 'settle')
          ||
          (existingData().status in ['draft', 'confirmed', 'settled']
            && incomingData().status == 'voided'
            && existingData().crewAdvanceCents == 0 && incomingData().crewAdvanceCents == 0
            && existingData().crewPaidCents == 0 && incomingData().crewPaidCents == 0
            && incomingData().diff(existingData()).affectedKeys().hasOnly([
              'status', 'voidReason', 'revision', 'voidedBy', 'voidedAt', 'updatedBy', 'updatedAt', 'lastActionId'
            ])
            && incomingData().voidedBy == uid()
            && incomingData().voidedAt == now()
            && incomingData().lastActionId == 'void'
            && afterData(/databases/$(database)/documents/vesselTrips/$(tripId)/actions/void).reason
              == incomingData().voidReason)
        );
      allow delete: if false;

      match /crew/{crewId} {
        allow read: if signedIn();
        allow create: if signedIn() && validVesselCrewSettlement(incomingData())
          && incomingData().id == crewId && incomingData().tripId == tripId
          && incomingData().createdBy == uid() && incomingData().createdAt == now()
          && incomingData().advanceCents == 0 && incomingData().paidCents == 0
          && beforeData(/databases/$(database)/documents/workers/$(incomingData().workerId)).active == true
          && beforeData(/databases/$(database)/documents/workers/$(incomingData().workerId)).department == 'vessel'
          && beforeData(/databases/$(database)/documents/workers/$(incomingData().workerId)).name
            == incomingData().workerNameSnapshot
          && beforeData(vesselTripPath(tripId)).status == 'draft'
          && incomingData().lastActionId == 'crew_add_' + crewId
          && afterData(vesselTripPath(tripId)).lastActionId == incomingData().lastActionId
          && afterData(vesselTripPath(tripId)).crewWageCents
            == beforeData(vesselTripPath(tripId)).crewWageCents + incomingData().grossWageCents
          && afterData(vesselTripPath(tripId)).crewAdvanceCents
            == beforeData(vesselTripPath(tripId)).crewAdvanceCents + incomingData().advanceCents;
        allow update: if signedIn() && validVesselCrewSettlement(incomingData())
          && validVesselCrewPaymentUpdate(tripId);
        allow delete: if false;
      }

      match /actions/{actionId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && incomingData().keys().hasAll(['type', 'performedBy', 'performedAt'])
          && incomingData().type in ['crew_add', 'entry_add', 'entry_void', 'confirm', 'settle', 'payment_create', 'payment_void', 'void']
          && incomingData().performedBy == uid()
          && incomingData().performedAt == now()
          && afterData(vesselTripPath(tripId)).lastActionId == actionId
          && (
            !(incomingData().type in ['entry_void', 'payment_void'])
            ||
            (incomingData().reason is string
              && incomingData().reason.size() >= 3 && incomingData().reason.size() <= 100
              && incomingData().beforeSnapshot is map
              && incomingData().afterSnapshot is map)
          );
        allow update, delete: if false;
      }
    }

    match /vesselTripEntries/{entryId} {
      allow read: if signedIn();
      allow create: if signedIn() && validVesselTripEntry(incomingData())
        && incomingData().createdBy == uid() && incomingData().createdAt == now()
        && incomingData().lastActionId == 'entry_add_' + entryId
        && beforeData(vesselTripPath(incomingData().tripId)).status == 'draft'
        && afterData(vesselTripPath(incomingData().tripId)).lastActionId == incomingData().lastActionId
        && (
          (incomingData().type == 'income'
            && afterData(vesselTripPath(incomingData().tripId)).incomeCents
              == beforeData(vesselTripPath(incomingData().tripId)).incomeCents + incomingData().amountCents
            && afterData(vesselTripPath(incomingData().tripId)).expenseCents
              == beforeData(vesselTripPath(incomingData().tripId)).expenseCents)
          ||
          (incomingData().type == 'expense'
            && afterData(vesselTripPath(incomingData().tripId)).expenseCents
              == beforeData(vesselTripPath(incomingData().tripId)).expenseCents + incomingData().amountCents
            && afterData(vesselTripPath(incomingData().tripId)).incomeCents
              == beforeData(vesselTripPath(incomingData().tripId)).incomeCents)
        );
      allow update: if signedIn() && validVesselTripEntry(incomingData())
        && existingData().voided == false && incomingData().voided == true
        && incomingData().diff(existingData()).affectedKeys().hasOnly(['voided', 'voidReason', 'lastActionId'])
        && incomingData().lastActionId == 'entry_void_' + entryId
        && afterData(vesselTripActionPath(existingData().tripId, incomingData().lastActionId)).reason
          == incomingData().voidReason
        && afterData(vesselTripActionPath(existingData().tripId, incomingData().lastActionId)).beforeSnapshot.type
          == existingData().type
        && afterData(vesselTripActionPath(existingData().tripId, incomingData().lastActionId)).beforeSnapshot.amountCents
          == existingData().amountCents
        && afterData(vesselTripActionPath(existingData().tripId, incomingData().lastActionId)).afterSnapshot.voided == true
        && afterData(vesselTripActionPath(existingData().tripId, incomingData().lastActionId)).afterSnapshot.incomeCents
          == afterData(vesselTripPath(existingData().tripId)).incomeCents
        && afterData(vesselTripActionPath(existingData().tripId, incomingData().lastActionId)).afterSnapshot.expenseCents
          == afterData(vesselTripPath(existingData().tripId)).expenseCents
        && beforeData(vesselTripPath(existingData().tripId)).status == 'draft'
        && afterData(vesselTripPath(existingData().tripId)).lastActionId == incomingData().lastActionId
        && (
          (existingData().type == 'income'
            && afterData(vesselTripPath(existingData().tripId)).incomeCents
              == beforeData(vesselTripPath(existingData().tripId)).incomeCents - existingData().amountCents)
          ||
          (existingData().type == 'expense'
            && afterData(vesselTripPath(existingData().tripId)).expenseCents
              == beforeData(vesselTripPath(existingData().tripId)).expenseCents - existingData().amountCents)
        );
      allow delete: if false;
    }

    match /vesselCrewPayments/{paymentId} {
      allow read: if signedIn();
      allow create: if signedIn() && validVesselCrewPayment(incomingData())
        && incomingData().createdBy == uid() && incomingData().createdAt == now()
        && incomingData().voided == false && incomingData().voidReason == null
        && incomingData().voidedBy == null && incomingData().voidedAt == null
        && incomingData().lastActionId == 'payment_create_' + paymentId
        && ((incomingData().paymentType == 'advance'
            && beforeData(vesselTripPath(incomingData().tripId)).status in ['draft', 'confirmed'])
          || (incomingData().paymentType == 'settlement'
            && beforeData(vesselTripPath(incomingData().tripId)).status == 'confirmed'))
        && incomingData().workerId
          == beforeData(vesselTripCrewPath(incomingData().tripId, incomingData().crewSettlementId)).workerId
        && incomingData().workerNameSnapshot
          == beforeData(vesselTripCrewPath(incomingData().tripId, incomingData().crewSettlementId)).workerNameSnapshot
        && incomingData().amountCents
          <= beforeData(vesselTripCrewPath(incomingData().tripId, incomingData().crewSettlementId)).balanceCents
        && ((incomingData().paymentType == 'advance'
            && afterData(vesselTripCrewPath(incomingData().tripId, incomingData().crewSettlementId)).advanceCents
              == beforeData(vesselTripCrewPath(incomingData().tripId, incomingData().crewSettlementId)).advanceCents
                + incomingData().amountCents
            && afterData(vesselTripPath(incomingData().tripId)).crewAdvanceCents
              == beforeData(vesselTripPath(incomingData().tripId)).crewAdvanceCents + incomingData().amountCents
            && afterData(vesselTripCrewPath(incomingData().tripId, incomingData().crewSettlementId)).paidCents
              == beforeData(vesselTripCrewPath(incomingData().tripId, incomingData().crewSettlementId)).paidCents)
          || (incomingData().paymentType == 'settlement'
            && afterData(vesselTripCrewPath(incomingData().tripId, incomingData().crewSettlementId)).paidCents
              == beforeData(vesselTripCrewPath(incomingData().tripId, incomingData().crewSettlementId)).paidCents
                + incomingData().amountCents
            && afterData(vesselTripPath(incomingData().tripId)).crewPaidCents
              == beforeData(vesselTripPath(incomingData().tripId)).crewPaidCents + incomingData().amountCents
            && afterData(vesselTripCrewPath(incomingData().tripId, incomingData().crewSettlementId)).advanceCents
              == beforeData(vesselTripCrewPath(incomingData().tripId, incomingData().crewSettlementId)).advanceCents));
      allow update: if signedIn() && validVesselCrewPayment(incomingData())
        && existingData().voided == false && incomingData().voided == true
        && incomingData().diff(existingData()).affectedKeys().hasOnly([
          'voided', 'voidReason', 'voidedBy', 'voidedAt', 'lastActionId'
        ])
        && incomingData().voidedBy == uid() && incomingData().voidedAt == now()
        && incomingData().lastActionId == 'payment_void_' + paymentId
        && beforeData(vesselTripPath(existingData().tripId)).status in ['draft', 'confirmed']
        && afterData(vesselTripActionPath(existingData().tripId, incomingData().lastActionId)).reason
          == incomingData().voidReason
        && afterData(vesselTripActionPath(existingData().tripId, incomingData().lastActionId)).beforeSnapshot.paymentType
          == existingData().paymentType
        && afterData(vesselTripActionPath(existingData().tripId, incomingData().lastActionId)).beforeSnapshot.amountCents
          == existingData().amountCents
        && afterData(vesselTripActionPath(existingData().tripId, incomingData().lastActionId)).beforeSnapshot.crewAdvanceCents
          == beforeData(vesselTripCrewPath(existingData().tripId, existingData().crewSettlementId)).advanceCents
        && afterData(vesselTripActionPath(existingData().tripId, incomingData().lastActionId)).beforeSnapshot.crewPaidCents
          == beforeData(vesselTripCrewPath(existingData().tripId, existingData().crewSettlementId)).paidCents
        && afterData(vesselTripActionPath(existingData().tripId, incomingData().lastActionId)).beforeSnapshot.tripAdvanceCents
          == beforeData(vesselTripPath(existingData().tripId)).crewAdvanceCents
        && afterData(vesselTripActionPath(existingData().tripId, incomingData().lastActionId)).beforeSnapshot.tripPaidCents
          == beforeData(vesselTripPath(existingData().tripId)).crewPaidCents
        && afterData(vesselTripActionPath(existingData().tripId, incomingData().lastActionId)).afterSnapshot.crewAdvanceCents
          == afterData(vesselTripCrewPath(existingData().tripId, existingData().crewSettlementId)).advanceCents
        && afterData(vesselTripActionPath(existingData().tripId, incomingData().lastActionId)).afterSnapshot.crewPaidCents
          == afterData(vesselTripCrewPath(existingData().tripId, existingData().crewSettlementId)).paidCents
        && afterData(vesselTripActionPath(existingData().tripId, incomingData().lastActionId)).afterSnapshot.tripAdvanceCents
          == afterData(vesselTripPath(existingData().tripId)).crewAdvanceCents
        && afterData(vesselTripActionPath(existingData().tripId, incomingData().lastActionId)).afterSnapshot.tripPaidCents
          == afterData(vesselTripPath(existingData().tripId)).crewPaidCents
        && ((existingData().paymentType == 'advance'
            && afterData(vesselTripCrewPath(existingData().tripId, existingData().crewSettlementId)).advanceCents
              == beforeData(vesselTripCrewPath(existingData().tripId, existingData().crewSettlementId)).advanceCents
                - existingData().amountCents
            && afterData(vesselTripPath(existingData().tripId)).crewAdvanceCents
              == beforeData(vesselTripPath(existingData().tripId)).crewAdvanceCents - existingData().amountCents
            && afterData(vesselTripCrewPath(existingData().tripId, existingData().crewSettlementId)).paidCents
              == beforeData(vesselTripCrewPath(existingData().tripId, existingData().crewSettlementId)).paidCents)
          || (existingData().paymentType == 'settlement'
            && afterData(vesselTripCrewPath(existingData().tripId, existingData().crewSettlementId)).paidCents
              == beforeData(vesselTripCrewPath(existingData().tripId, existingData().crewSettlementId)).paidCents
                - existingData().amountCents
            && afterData(vesselTripPath(existingData().tripId)).crewPaidCents
              == beforeData(vesselTripPath(existingData().tripId)).crewPaidCents - existingData().amountCents
            && afterData(vesselTripCrewPath(existingData().tripId, existingData().crewSettlementId)).advanceCents
              == beforeData(vesselTripCrewPath(existingData().tripId, existingData().crewSettlementId)).advanceCents));
      allow delete: if false;
    }

    match /fishHeadWageEntries/{entryId} {
      allow read: if signedIn();
      allow create: if signedIn() && validWageEntry(incomingData())
        && incomingData().keys().hasAll(['businessDate', 'dateSortKey', 'monthKey', 'monthSortKey'])
        && incomingData().createdBy == uid()
        && incomingData().deleted == false
        && incomingData().createdAt == now()
        && incomingData().updatedAt == now()
        && monthOpenAfter(incomingData().dateKey);
      allow update: if signedIn() && validWageEntry(incomingData())
        && existingData().deleted == false && incomingData().deleted == true
        && incomingData().diff(existingData()).affectedKeys().hasOnly(['deleted', 'updatedAt'])
        && incomingData().updatedAt == now()
        && monthOpenAfter(existingData().dateKey);
      allow delete: if false;
    }

    match /fishHeadWageVoids/{voidId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && incomingData().keys().hasOnly([
          'entryId', 'dateKey', 'workerId', 'workerName', 'weightKg',
          'rateRm', 'wageRm', 'voidReason', 'voidedBy', 'voidedAt'
        ])
        && incomingData().keys().hasAll([
          'entryId', 'dateKey', 'workerId', 'workerName', 'weightKg',
          'rateRm', 'wageRm', 'voidReason', 'voidedBy', 'voidedAt'
        ])
        && incomingData().entryId == voidId
        && incomingData().workerName is string && incomingData().workerName.size() > 0
        && incomingData().weightKg is int && incomingData().weightKg >= 1 && incomingData().weightKg <= 300
        && incomingData().rateRm is string && incomingData().rateRm.matches('^[0-9][.][0-9]{2}$')
        && incomingData().wageRm is string && incomingData().wageRm.matches('^[0-9]+[.][0-9]{2}$')
        && incomingData().voidReason is string && incomingData().voidReason.size() > 0 && incomingData().voidReason.size() <= 100
        && incomingData().voidedBy == uid()
        && incomingData().voidedAt == now()
        && monthOpenAfter(incomingData().dateKey)
        && beforeData(/databases/$(database)/documents/fishHeadWageEntries/$(voidId)).deleted == false
        && afterData(/databases/$(database)/documents/fishHeadWageEntries/$(voidId)).deleted == true
        && incomingData().dateKey == afterData(/databases/$(database)/documents/fishHeadWageEntries/$(voidId)).dateKey
        && incomingData().workerId == afterData(/databases/$(database)/documents/fishHeadWageEntries/$(voidId)).workerId
        && incomingData().workerName == afterData(/databases/$(database)/documents/fishHeadWageEntries/$(voidId)).workerName
        && incomingData().weightKg == afterData(/databases/$(database)/documents/fishHeadWageEntries/$(voidId)).weightKg
        && incomingData().rateRm == afterData(/databases/$(database)/documents/fishHeadWageEntries/$(voidId)).rateRm
        && incomingData().wageRm == afterData(/databases/$(database)/documents/fishHeadWageEntries/$(voidId)).wageRm;
      allow update, delete: if false;
    }

    match /fishHeadWageMonths/{monthKey} {
      allow read: if signedIn();
      allow create: if signedIn() && validMonth(incomingData())
        && incomingData().monthKey == monthKey
        && incomingData().status == 'open'
        && incomingData().closeVersion == 0
        && incomingData().workerCount == 0
        && incomingData().basketCount == 0
        && incomingData().totalWeightKg == 0
        && incomingData().totalWageCents == 0
        && incomingData().paidCents == 0
        && incomingData().closedBy == null
        && incomingData().closedAt == null
        && incomingData().closingToken is string
        && incomingData().closingBy == uid()
        && incomingData().closingAt == now()
        && incomingData().updatedAt == now()
        && incomingData().lastActionId == 'closing_lock'
        && incomingData().statementIds.size() == 0;
      allow update: if signedIn() && validMonth(incomingData())
        && incomingData().monthKey == existingData().monthKey
        && (
          (existingData().status == 'open'
            && (existingData().closingToken == null
              || now() >= existingData().closingAt + duration.value(5, 'm'))
            && incomingData().status == 'open'
            && incomingData().diff(existingData()).affectedKeys()
              .hasOnly(['closingToken', 'closingBy', 'closingAt', 'updatedAt'])
            && incomingData().closingToken is string
            && incomingData().closingBy == uid()
            && incomingData().closingAt == now()
            && incomingData().updatedAt == now())
          ||
          (existingData().status == 'open'
            && existingData().closingToken is string
            && existingData().closingBy == uid()
            && incomingData().status == 'closed'
            && incomingData().closeVersion == existingData().closeVersion + 1
            && incomingData().paidCents == 0
            && incomingData().closedBy == uid()
            && incomingData().closedAt == now()
            && incomingData().updatedAt == now()
            && incomingData().closingToken == null
            && incomingData().closingBy == null
            && incomingData().closingAt == null
            && validCloseAction(monthKey, incomingData().closeVersion, incomingData().lastActionId))
          ||
          (existingData().status == 'open'
            && existingData().closingToken is string
            && existingData().closingBy == uid()
            && incomingData().status == 'open'
            && incomingData().diff(existingData()).affectedKeys()
              .hasOnly(['closingToken', 'closingBy', 'closingAt', 'updatedAt'])
            && incomingData().closingToken == null
            && incomingData().closingBy == null
            && incomingData().closingAt == null
            && incomingData().updatedAt == now())
          ||
          (existingData().status == 'closed'
            && existingData().paidCents == 0
            && incomingData().status == 'open'
            && incomingData().closeVersion == existingData().closeVersion
            && incomingData().diff(existingData()).affectedKeys().hasOnly([
              'status', 'reopenedBy', 'reopenedAt', 'updatedAt', 'lastActionId'
            ])
            && incomingData().reopenedBy == uid()
            && incomingData().reopenedAt == now()
            && incomingData().updatedAt == now()
            && incomingData().lastActionId == 'reopen_' + string(existingData().closeVersion)
            && existsAfter(actionPath(monthKey, incomingData().lastActionId))
            && afterData(actionPath(monthKey, incomingData().lastActionId)).type == 'reopen'
            && afterData(actionPath(monthKey, incomingData().lastActionId)).reason is string
            && afterData(actionPath(monthKey, incomingData().lastActionId)).performedBy == uid()
            && afterData(actionPath(monthKey, incomingData().lastActionId)).beforeSnapshot.status == 'closed'
            && afterData(actionPath(monthKey, incomingData().lastActionId)).beforeSnapshot.paidCents == 0
            && afterData(actionPath(monthKey, incomingData().lastActionId)).afterSnapshot.status == 'open'
            && afterData(actionPath(monthKey, incomingData().lastActionId)).afterSnapshot.paidCents == 0)
          ||
          validPaymentMonthUpdate(monthKey)
        );
      allow delete: if false;

      match /statements/{statementId} {
        allow read: if signedIn();
        allow create: if signedIn() && validStatement(incomingData())
          && incomingData().id == statementId
          && incomingData().monthKey == monthKey
          && incomingData().paidCents == 0
          && incomingData().createdBy == uid()
          && incomingData().snapshotAt == now()
          && afterData(monthPath(monthKey)).status == 'closed'
          && incomingData().closeVersion == afterData(monthPath(monthKey)).closeVersion
          && incomingData().lastActionId == afterData(monthPath(monthKey)).lastActionId
          && statementId in afterData(monthPath(monthKey)).statementIds
          && validCloseAction(monthKey, incomingData().closeVersion, incomingData().lastActionId);
        allow update: if signedIn() && validStatement(incomingData())
          && incomingData().diff(existingData()).affectedKeys().hasOnly(['paidCents', 'lastActionId'])
          && incomingData().closeVersion == existingData().closeVersion
          && incomingData().lastActionId == afterData(monthPath(monthKey)).lastActionId
          && existsAfter(actionPath(monthKey, incomingData().lastActionId))
          && afterData(actionPath(monthKey, incomingData().lastActionId)).workerId == existingData().workerId
          && afterData(actionPath(monthKey, incomingData().lastActionId)).closeVersion == existingData().closeVersion
          && (
            (afterData(actionPath(monthKey, incomingData().lastActionId)).type == 'payment_create'
              && incomingData().paidCents == existingData().paidCents
                + afterData(paymentPath(monthKey, afterData(actionPath(monthKey, incomingData().lastActionId)).paymentId)).amountCents)
            ||
            (afterData(actionPath(monthKey, incomingData().lastActionId)).type == 'payment_void'
              && incomingData().paidCents == existingData().paidCents
                - afterData(paymentPath(monthKey, afterData(actionPath(monthKey, incomingData().lastActionId)).paymentId)).amountCents)
          );
        allow delete: if false;
      }

      match /payments/{paymentId} {
        allow read: if signedIn();
        allow create: if signedIn() && validPayment(incomingData())
          && incomingData().monthKey == monthKey
          && incomingData().createdBy == uid()
          && incomingData().createdAt == now()
          && incomingData().voided == false
          && incomingData().voidReason == null
          && incomingData().voidedBy == null
          && incomingData().voidedAt == null
          && beforeData(monthPath(monthKey)).status == 'closed'
          && incomingData().closeVersion == beforeData(monthPath(monthKey)).closeVersion
          && beforeData(statementPath(monthKey, incomingData().statementId)).closeVersion == incomingData().closeVersion
          && incomingData().workerId == beforeData(statementPath(monthKey, incomingData().statementId)).workerId
          && incomingData().workerName == beforeData(statementPath(monthKey, incomingData().statementId)).workerName
          && incomingData().amountCents <= beforeData(statementPath(monthKey, incomingData().statementId)).wageCents
            - beforeData(statementPath(monthKey, incomingData().statementId)).paidCents
          && afterData(statementPath(monthKey, incomingData().statementId)).paidCents
            == beforeData(statementPath(monthKey, incomingData().statementId)).paidCents + incomingData().amountCents
          && afterData(monthPath(monthKey)).paidCents
            == beforeData(monthPath(monthKey)).paidCents + incomingData().amountCents
          && afterData(statementPath(monthKey, incomingData().statementId)).lastActionId == 'payment_create_' + paymentId
          && afterData(monthPath(monthKey)).lastActionId == 'payment_create_' + paymentId
          && existsAfter(actionPath(monthKey, 'payment_create_' + paymentId));
        allow update: if signedIn() && validPayment(incomingData())
          && existingData().voided == false && incomingData().voided == true
          && incomingData().diff(existingData()).affectedKeys().hasOnly(['voided', 'voidReason', 'voidedBy', 'voidedAt'])
          && incomingData().voidReason is string
          && incomingData().voidReason.size() >= 3 && incomingData().voidReason.size() <= 100
          && incomingData().voidedBy == uid()
          && incomingData().voidedAt == now()
          && afterData(statementPath(monthKey, existingData().statementId)).paidCents
            == beforeData(statementPath(monthKey, existingData().statementId)).paidCents - existingData().amountCents
          && afterData(monthPath(monthKey)).paidCents
            == beforeData(monthPath(monthKey)).paidCents - existingData().amountCents
          && afterData(statementPath(monthKey, existingData().statementId)).paidCents >= 0
          && afterData(monthPath(monthKey)).paidCents >= 0
          && afterData(statementPath(monthKey, existingData().statementId)).lastActionId == 'payment_void_' + paymentId
          && afterData(monthPath(monthKey)).lastActionId == 'payment_void_' + paymentId
          && existsAfter(actionPath(monthKey, 'payment_void_' + paymentId))
          && afterData(actionPath(monthKey, 'payment_void_' + paymentId)).reason
            == incomingData().voidReason
          && afterData(actionPath(monthKey, 'payment_void_' + paymentId)).beforeSnapshot.amountCents
            == existingData().amountCents
          && afterData(actionPath(monthKey, 'payment_void_' + paymentId)).beforeSnapshot.statementPaidCents
            == beforeData(statementPath(monthKey, existingData().statementId)).paidCents
          && afterData(actionPath(monthKey, 'payment_void_' + paymentId)).beforeSnapshot.monthPaidCents
            == beforeData(monthPath(monthKey)).paidCents
          && afterData(actionPath(monthKey, 'payment_void_' + paymentId)).afterSnapshot.statementPaidCents
            == afterData(statementPath(monthKey, existingData().statementId)).paidCents
          && afterData(actionPath(monthKey, 'payment_void_' + paymentId)).afterSnapshot.monthPaidCents
            == afterData(monthPath(monthKey)).paidCents;
        allow delete: if false;
      }

      match /actions/{actionId} {
        allow read: if signedIn();
        allow create: if signedIn() && validAction(incomingData())
          && incomingData().monthKey == monthKey
          && afterData(monthPath(monthKey)).lastActionId == actionId
          && (
            (incomingData().type == 'close' && actionId == 'close_' + string(incomingData().closeVersion))
            || (incomingData().type == 'reopen' && actionId == 'reopen_' + string(incomingData().closeVersion))
            || (incomingData().type == 'payment_create'
              && actionId == 'payment_create_' + incomingData().paymentId
              && afterData(paymentPath(monthKey, incomingData().paymentId)).createdAt == now()
              && incomingData().afterSnapshot.amountCents
                == afterData(paymentPath(monthKey, incomingData().paymentId)).amountCents
              && incomingData().afterSnapshot.statementPaidCents
                == afterData(statementPath(
                  monthKey,
                  afterData(paymentPath(monthKey, incomingData().paymentId)).statementId
                )).paidCents
              && incomingData().afterSnapshot.monthPaidCents
                == afterData(monthPath(monthKey)).paidCents)
            || (incomingData().type == 'payment_void'
              && actionId == 'payment_void_' + incomingData().paymentId
              && afterData(paymentPath(monthKey, incomingData().paymentId)).voidedAt == now()
              && incomingData().reason
                == afterData(paymentPath(monthKey, incomingData().paymentId)).voidReason)
          );
        allow update, delete: if false;
      }
    }
  }
}
