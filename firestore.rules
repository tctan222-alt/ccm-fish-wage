            && validActivePurchaseParties(request.resource.data)
            && request.resource.data.draftVersion == resource.data.draftVersion + 1
            && request.resource.data.paidCents == 0 && request.resource.data.paymentStatus == 'unpaid'
            && request.resource.data.confirmedBy == null && request.resource.data.confirmedAt == null
