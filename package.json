{
  "name": "ccm-fish-wage",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/write-build-manifest.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-ccm-rules \"vitest run --config vitest.rules.config.ts src/firestore.rules.test.ts\"",
    "test:rules:size": "node scripts/check-firestore-rules-size.mjs",
    "ql-master": "tsx scripts/ql-master.ts"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "jspdf": "^4.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.7.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7",
    "minimatch@>=7 <11.0.1": "11.0.1",
    "glob@>=9 <=14.0.1": "14.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@google-cloud/firestore": "8.7.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "google-auth-library": "10.5.0",
    "jsdom": "^26.1.0",
    "tsx": "4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.0",
    "vitest": "4.1.12"
  }
}
